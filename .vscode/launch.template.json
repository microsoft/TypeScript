{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "extensionHost",
            "request": "launch",
            "name": "Launch VS Code extension",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-typescript"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/vscode-typescript/dist/**/*.js"
            ],
            "autoAttachChildProcesses": true,
            "preLaunchTask": "Watch for extension run"
        },
        {
            "name": "Launch compiler test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/tsc/internal/testrunner",
            "args": ["-test.run", "TestLocal/${fileBasename}"]
        },
        {
            "name": "Launch compiler test with CPU profile",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/tsc/internal/testrunner",
            "args": [
                "-test.cpuprofile",
                "${workspaceFolder}/test.prof",
                "-test.run",
                "TestLocal/${fileBasename}"
            ]
        },
        {
            "name": "Launch fourslash test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/tsc/internal/fourslash/gen/${fileBasename}"
        },
        {
            "name": "Launch replay test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/tsc/internal/lsp",
            "args": [
                "-test.run",
                "^TestReplay$",
                "-replay",
                "path_to_replay_log.txt",
                "-testDir",
                "path_to_project_dir"
            ]
        },
        {
            "name": "Launch tsc CLI",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/tsc/cmd/tsc",
            "cwd": "${workspaceFolder}/tsc",
            "args": "${input:tscArgs}"
        },
        {
            "name": "Attach to Go process",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": "${command:pickGoProcess}"
        }
    ],
    "inputs": [
        {
            "id": "tscArgs",
            "type": "promptString",
            "description": "Enter arguments for tsc"
        }
    ]
}
