{
    "private": true,
    "name": "@typescript/typescript-wasip1-wasm",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "author": "Microsoft Corp.",
    "homepage": "https://www.typescriptlang.org/",
    "description": "TypeScript compiler, language server, and API transport for wasip1/wasm",
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@typescript/source": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./tsc.wasm": "./dist/tsc.wasm"
    },
    "imports": {
        "#wasmURL": {
            "@typescript/source": "./src/wasmURL.source.ts",
            "default": "./dist/wasmURL.js"
        }
    },
    "scripts": {
        "build": "hereby --herebyfile ../../Herebyfile.mjs build:wasip1",
        "build:js": "tsc -b"
    }
}
