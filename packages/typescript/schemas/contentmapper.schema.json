{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "TypeScript content mapper protocol",
    "description": "Content mapper JSON-RPC methods and reusable parameter and result definitions. Reference individual protocol types through #/definitions/<TypeName>. Positions use the encoding selected during initialization.",
    "x-methods": {
        "initialize": {
            "params": {
                "$ref": "#/definitions/InitializeParams"
            },
            "result": {
                "$ref": "#/definitions/InitializeResult"
            }
        },
        "openProject": {
            "params": {
                "$ref": "#/definitions/OpenProjectParams"
            },
            "result": {
                "$ref": "#/definitions/OpenProjectResult"
            }
        },
        "closeProject": {
            "params": {
                "$ref": "#/definitions/CloseProjectParams"
            },
            "result": {
                "type": "null"
            }
        },
        "transform": {
            "params": {
                "$ref": "#/definitions/TransformParams"
            },
            "result": {
                "$ref": "#/definitions/TransformResult"
            }
        }
    },
    "definitions": {
        "InitializeParams": {
            "type": "object",
            "description": "Parameters for the initialize request.",
            "properties": {
                "locale": {
                    "type": "string",
                    "description": "BCP 47 locale for mapper-authored diagnostic messages, when configured."
                },
                "positionEncodings": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/PositionEncoding"
                    },
                    "description": "Coordinate spaces accepted by the host."
                }
            },
            "required": ["positionEncodings"]
        },
        "InitializeResult": {
            "type": "object",
            "description": "Response to the initialize request.",
            "properties": {
                "positionEncoding": {
                    "$ref": "#/definitions/PositionEncoding"
                },
                "diagnosticSource": {
                    "type": "string",
                    "pattern": "\\S",
                    "description": "Prefix for mapper-authored diagnostic codes. It must not be whitespace-only or, ignoring case, typescript, tsc, or a native source extension without its leading dot."
                }
            },
            "required": ["positionEncoding", "diagnosticSource"]
        },
        "OpenProjectParams": {
            "type": "object",
            "description": "Parameters for the openProject request.",
            "properties": {
                "configFileName": {
                    "type": "string",
                    "description": "Absolute project configuration file name, or an empty string when there is none."
                },
                "projectHandle": {
                    "type": "string",
                    "description": "Opaque, process-local project handle assigned by the host."
                },
                "options": {
                    "description": "Mapper entry's options from the project's contentMappers configuration."
                },
                "compilerOptions": {
                    "description": "Project's effective compiler options, serialized by the host."
                }
            },
            "required": ["configFileName", "projectHandle", "compilerOptions"]
        },
        "OpenProjectResult": {
            "type": "object",
            "description": "Response to an openProject request. Only mappers declaring dynamicConfig may return a non-empty configIdentity or watchedFiles.",
            "properties": {
                "configIdentity": {
                    "type": "string",
                    "description": "Stable fingerprint of all dynamic configuration affecting transforms. It must be non-empty for dynamicConfig mappers; otherwise it must be empty or omitted."
                },
                "watchedFiles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Absolute file names whose changes may alter configIdentity or transform output."
                },
                "optionDiagnostics": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/OptionDiagnosticResult"
                    },
                    "description": "Diagnostics reporting invalid mapper options."
                }
            }
        },
        "OptionDiagnosticResult": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "integer",
                                "minimum": 0
                            }
                        ]
                    },
                    "description": "Property names and array indices relative to the mapper entry's options object."
                },
                "messageText": {
                    "type": "string"
                },
                "code": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                }
            },
            "required": ["path", "messageText", "code"]
        },
        "CloseProjectParams": {
            "type": "object",
            "description": "Parameters for the closeProject request.",
            "properties": {
                "projectHandle": {
                    "type": "string"
                }
            },
            "required": ["projectHandle"]
        },
        "PositionEncoding": {
            "type": "string",
            "enum": ["utf-8", "utf-16"],
            "description": "Coordinate space for mappings and diagnostics: UTF-8 byte offsets or UTF-16 code unit offsets."
        },
        "TransformParams": {
            "type": "object",
            "description": "Parameters for the transform request.",
            "properties": {
                "fileName": {
                    "type": "string",
                    "description": "Absolute name of the content-mapped source file."
                },
                "content": {
                    "type": "string",
                    "description": "Original source text."
                },
                "projectHandle": {
                    "type": "string",
                    "description": "Handle for the project configuration opened for this transform."
                }
            },
            "required": ["fileName", "content", "projectHandle"]
        },
        "MappedOutput": {
            "type": "object",
            "description": "Virtual source text and its mapping to the original input.",
            "properties": {
                "text": {
                    "type": "string",
                    "description": "Virtual source text."
                },
                "extension": {
                    "type": "string",
                    "enum": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts", ".json"],
                    "description": "Extension determining the virtual source file's syntax."
                },
                "mappings": {
                    "type": ["array", "null"],
                    "items": {
                        "$ref": "#/definitions/SpanMapSegment"
                    },
                    "description": "Span map tuples in the selected position encoding. Absent, null, or empty mappings describe fully synthesized output."
                },
                "diagnosticDirectives": {
                    "$ref": "#/definitions/DiagnosticDirectives"
                }
            },
            "required": ["text", "extension"]
        },
        "SpanMapKind": {
            "type": "integer",
            "description": "Relationship between positions in a virtual span and its original span.",
            "oneOf": [
                {
                    "const": 0,
                    "title": "Verbatim",
                    "description": "Length-preserving segment whose interior positions map one-to-one."
                },
                {
                    "const": 1,
                    "title": "Atom",
                    "description": "Segment mapped as a whole; interior positions clamp to its endpoints."
                },
                {
                    "const": 2,
                    "title": "Alias",
                    "description": "Atom geometry whose virtual and original texts name the same logical entity."
                }
            ]
        },
        "SpanMapFidelity": {
            "type": "integer",
            "description": "Faithfulness of a mapped span to the original.",
            "oneOf": [
                {
                    "const": 0,
                    "title": "Exact",
                    "description": "Span entirely within a single verbatim segment, mapped precisely."
                },
                {
                    "const": 1,
                    "title": "Atom",
                    "description": "Span within a single atom segment, mapped to that atom's span."
                },
                {
                    "const": 2,
                    "title": "Approximate",
                    "description": "Span crossing segment boundaries, with mapped and clamped endpoints."
                },
                {
                    "const": 3,
                    "title": "None",
                    "description": "Synthesized span with no original counterpart."
                }
            ]
        },
        "SpanMapFeature": {
            "type": "integer",
            "description": "Language-service feature bitmask. Diagnostics and exact edit mapping do not use feature filtering. Named flags may be combined.",
            "anyOf": [
                { "const": 1, "title": "Hover" },
                { "const": 2, "title": "SignatureHelp" },
                { "const": 4, "title": "Completion" },
                { "const": 8, "title": "Definition" },
                { "const": 16, "title": "TypeDefinition" },
                { "const": 32, "title": "Implementation" },
                { "const": 64, "title": "References" },
                { "const": 128, "title": "DocumentHighlights" },
                { "const": 256, "title": "Rename" },
                { "const": 512, "title": "CallHierarchy" },
                { "const": 1024, "title": "CodeActions" },
                { "const": 2048, "title": "Formatting" },
                { "const": 4096, "title": "InlayHints" },
                { "const": 8192, "title": "SemanticTokens" },
                { "const": 16384, "title": "FoldingRanges" },
                { "const": 32768, "title": "SelectionRanges" },
                { "const": 65536, "title": "LinkedEditing" },
                { "const": 131072, "title": "AutoInsert" },
                { "const": 262144, "title": "DocumentSymbols" },
                { "const": 524288, "title": "CodeLens" },
                { "const": 0, "title": "None" },
                { "const": 1048575, "title": "All" },
                { "minimum": 0, "maximum": 1048575 }
            ]
        },
        "SpanMapOffset": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
        },
        "SpanMapTextRange": {
            "type": "object",
            "properties": {
                "pos": { "$ref": "#/definitions/SpanMapOffset" },
                "end": { "$ref": "#/definitions/SpanMapOffset" }
            },
            "required": ["pos", "end"]
        },
        "SpanMapSourceSegment": {
            "type": "object",
            "description": "Mapping from a half-open virtual range to a half-open original range. Features controls language-service participation; diagnostics and exact edit mapping deliberately bypass it.",
            "properties": {
                "virtualStart": { "$ref": "#/definitions/SpanMapOffset" },
                "virtualEnd": { "$ref": "#/definitions/SpanMapOffset" },
                "originalStart": { "$ref": "#/definitions/SpanMapOffset" },
                "originalEnd": { "$ref": "#/definitions/SpanMapOffset" },
                "kind": { "$ref": "#/definitions/SpanMapKind" },
                "features": { "$ref": "#/definitions/SpanMapFeature" }
            },
            "required": ["virtualStart", "virtualEnd", "originalStart", "originalEnd", "kind"]
        },
        "SpanMapPosition": {
            "type": "object",
            "description": "Virtual projection of an original position and its mapping fidelity.",
            "properties": {
                "position": { "$ref": "#/definitions/SpanMapOffset" },
                "fidelity": { "$ref": "#/definitions/SpanMapFidelity" }
            },
            "required": ["position", "fidelity"]
        },
        "SpanMapRange": {
            "type": "object",
            "description": "Virtual projection of an original range and its mapping fidelity.",
            "properties": {
                "range": { "$ref": "#/definitions/SpanMapTextRange" },
                "fidelity": { "$ref": "#/definitions/SpanMapFidelity" }
            },
            "required": ["range", "fidelity"]
        },
        "SpanMapSegment": {
            "type": "array",
            "description": "[virtualStart, virtualLength, originalStart, originalLength, kind, features?]. Segments must be ordered and disjoint in virtual space and within both texts. Verbatim segments must contain identical text.",
            "items": [
                {
                    "type": "integer",
                    "title": "virtualStart",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "Virtual start offset."
                },
                {
                    "type": "integer",
                    "title": "virtualLength",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "Virtual span length."
                },
                {
                    "type": "integer",
                    "title": "originalStart",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "Original start offset."
                },
                {
                    "type": "integer",
                    "title": "originalLength",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "Original span length."
                },
                {
                    "$ref": "#/definitions/SpanMapKind",
                    "title": "kind"
                },
                {
                    "$ref": "#/definitions/SpanMapFeature",
                    "title": "features",
                    "description": "Language-service feature bitmask. Omitted means all features (1048575); 0 disables all features. Does not suppress diagnostics."
                }
            ],
            "minItems": 5,
            "maxItems": 6
        },
        "DiagnosticDirectivePolicy": {
            "type": "integer",
            "enum": [0, 1],
            "description": "Diagnostic directive policy: 0 ignores diagnostics; 1 expects a diagnostic."
        },
        "UnusedExpectDirectiveDiagnostic": {
            "type": "object",
            "description": "Diagnostic reported when an expect directive suppresses no diagnostic.",
            "properties": {
                "code": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                },
                "messageText": {
                    "type": "string"
                }
            },
            "required": ["code", "messageText"]
        },
        "DiagnosticDirectives": {
            "type": "object",
            "description": "Shared unused-expect diagnostics and compact diagnostic directive tuples.",
            "properties": {
                "unusedExpectDirectiveDiagnostics": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/UnusedExpectDirectiveDiagnostic"
                    }
                },
                "directives": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/MappedDiagnosticDirective"
                    },
                    "description": "Directives with non-overlapping virtual ranges."
                }
            },
            "required": ["unusedExpectDirectiveDiagnostics", "directives"]
        },
        "MappedDiagnosticDirective": {
            "title": "Diagnostic directive",
            "description": "[originalStart, originalLength, virtualStart, virtualEnd, 0, ...diagnosticCodes] or [originalStart, originalLength, virtualStart, virtualEnd, 1, unusedExpectDirectiveIndex?].",
            "oneOf": [
                {
                    "type": "array",
                    "description": "Ignore directive suppressing TypeScript diagnostics in the virtual range. An invalid original range is ignored. When diagnostic codes are given, only matching diagnostics are suppressed.",
                    "items": [
                        {
                            "type": "integer",
                            "title": "originalStart",
                            "description": "Original start offset."
                        },
                        {
                            "type": "integer",
                            "title": "originalLength",
                            "description": "Original span length."
                        },
                        {
                            "type": "integer",
                            "minimum": 0,
                            "title": "virtualStart",
                            "description": "Inclusive virtual start offset."
                        },
                        {
                            "type": "integer",
                            "minimum": 0,
                            "title": "virtualEnd",
                            "description": "Exclusive virtual end offset, which must not precede the start."
                        },
                        {
                            "type": "integer",
                            "const": 0,
                            "title": "policy",
                            "description": "Ignore directive policy."
                        }
                    ],
                    "additionalItems": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647,
                        "title": "diagnosticCode",
                        "description": "TypeScript diagnostic code to ignore."
                    },
                    "minItems": 5
                },
                {
                    "type": "array",
                    "description": "Expect directive suppressing TypeScript diagnostics in the virtual range. It requires a valid original range and reports an unused-expect diagnostic there when no diagnostic is suppressed.",
                    "items": [
                        {
                            "type": "integer",
                            "title": "originalStart",
                            "minimum": 0,
                            "description": "Original start offset."
                        },
                        {
                            "type": "integer",
                            "title": "originalLength",
                            "minimum": 0,
                            "description": "Original span length."
                        },
                        {
                            "type": "integer",
                            "minimum": 0,
                            "title": "virtualStart",
                            "description": "Inclusive virtual start offset."
                        },
                        {
                            "type": "integer",
                            "minimum": 0,
                            "title": "virtualEnd",
                            "description": "Exclusive virtual end offset, which must not precede the start."
                        },
                        {
                            "type": "integer",
                            "const": 1,
                            "title": "policy",
                            "description": "Expect directive policy."
                        },
                        {
                            "type": "integer",
                            "minimum": 0,
                            "title": "unusedExpectDirectiveIndex",
                            "description": "Index into unusedExpectDirectiveDiagnostics. An omitted index selects the only shared unused-expect diagnostic and requires exactly one such diagnostic."
                        }
                    ],
                    "minItems": 5,
                    "maxItems": 6
                }
            ]
        },
        "SupplementalOutput": {
            "$ref": "#/definitions/MappedOutput"
        },
        "TransformResult": {
            "description": "Canonical output for one input file, with optional mapper diagnostics and supplemental compiler inputs.",
            "allOf": [
                {
                    "$ref": "#/definitions/MappedOutput"
                },
                {
                    "type": "object",
                    "properties": {
                        "diagnostics": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Diagnostic"
                            },
                            "description": "Mapper-authored errors in original-source coordinates."
                        },
                        "supplemental": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/SupplementalOutput"
                            },
                            "description": "Additional unnamed compiler inputs associated with this source file."
                        }
                    }
                }
            ]
        },
        "Diagnostic": {
            "type": "object",
            "description": "Mapper-authored error in original-source coordinates using the selected position encoding.",
            "properties": {
                "messageText": {
                    "type": "string"
                },
                "start": {
                    "type": "integer",
                    "minimum": 0
                },
                "length": {
                    "type": "integer",
                    "minimum": 0
                },
                "code": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                }
            },
            "required": ["messageText", "start", "length", "code"]
        }
    }
}
