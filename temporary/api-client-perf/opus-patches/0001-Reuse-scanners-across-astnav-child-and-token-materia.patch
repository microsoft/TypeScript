+
+    test("a scanner is returned to the pool when child creation throws", () => {
+        const text = "if (a) { b(); } else { c(); }\n";
+        withSourceFiles({ "/src/t.ts": text }, ([sf]) => {
+            const stmt = sf.statements[0];
