From 4551280766db7f2f4827d057af78cecf1a92ca06 Mon Sep 17 00:00:00 2001
From: Andrew Branch <andrewbranch@users.noreply.github.com>
Date: Tue, 13 Oct 2026 17:51:29 +0000
Subject: [PATCH 2/6] Omit zero-valued fields from type, symbol, and signature
 responses

encoding/json/v2 only omits empty JSON values for omitempty, so every
TypeResponse carried "objectFlags":0, "isTupleType":false, "value":null and
"isThisType":false, every SymbolResponse "checkFlags":0, and every
SignatureResponse "flags":0. Use omitzero and default the fields on the
client.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 packages/typescript/src/api/async/api.ts       |  8 ++++----
 packages/typescript/src/api/proto.generated.ts |  8 ++++----
 packages/typescript/src/api/sync/api.ts        |  8 ++++----
 tsc/internal/api/proto.go                      | 14 +++++++-------
 4 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/packages/typescript/src/api/async/api.ts b/packages/typescript/src/api/async/api.ts
index 6c1eb48012..36c39b66ca 100644
--- a/packages/typescript/src/api/async/api.ts
+++ b/packages/typescript/src/api/async/api.ts
@@ -3259,7 +3259,7 @@ export class Symbol {
         this.escapedName = data.name as __String;
         this.name = unescapeLeadingUnderscores(data.name as __String);
         this.flags = data.flags;
-        this.checkFlags = data.checkFlags;
+        this.checkFlags = data.checkFlags ?? 0;
         // A file-owned symbol has no canonical project; its declarations resolve through its file.
         const project = storage.kind === SymbolOwnerKind.Snapshot ? storage.registry.project : undefined;
         const fileOwner = storage.kind === SymbolOwnerKind.File ? storage.owner : undefined;
@@ -3410,7 +3410,7 @@ class TypeObject implements Type {
 
         this.id = data.id;
         this.flags = data.flags;
-        if (data.objectFlags !== undefined) this.objectFlags = data.objectFlags;
+        this.objectFlags = data.objectFlags ?? 0;
         if (data.symbol !== undefined) this.symbol = data.symbol;
         if (data.value != null) {
             // BigInt literal values are serialized as decimal strings (e.g. "-123") because
@@ -3436,7 +3436,7 @@ class TypeObject implements Type {
             }
         }
         if (data.intrinsicName !== undefined) this.intrinsicName = data.intrinsicName;
-        if (data.isThisType !== undefined) this.isThisType = data.isThisType;
+        this.isThisType = data.isThisType ?? false;
         if (data.freshType !== undefined) this.freshType = data.freshType;
         if (data.regularType !== undefined) this.regularType = data.regularType;
         if (data.target !== undefined) this.target = data.target;
@@ -3891,7 +3891,7 @@ export class Signature {
 
     constructor(data: SignatureResponse, project: Project, objectRegistry: ProjectObjectRegistry) {
         this.id = data.id;
-        this.flags = data.flags;
+        this.flags = data.flags ?? 0;
         this.objectRegistry = objectRegistry;
         this.declaration = data.declaration ? new NodeHandle<Declaration>(data.declaration, project) : undefined;
         this.typeParameters = data.typeParameters ?? [];
diff --git a/packages/typescript/src/api/proto.generated.ts b/packages/typescript/src/api/proto.generated.ts
index 01e2fa27b1..abef8c6aa1 100644
--- a/packages/typescript/src/api/proto.generated.ts
+++ b/packages/typescript/src/api/proto.generated.ts
@@ -271,7 +271,7 @@ export interface SymbolResponse {
     reference: SymbolReference;
     name: string;
     flags: number;
-    checkFlags: number;
+    checkFlags?: number | undefined;
     declarations?: string[] | undefined;
     valueDeclaration?: string | undefined;
     parent?: CompactSymbolReference | undefined;
@@ -524,9 +524,9 @@ export interface TypeResponse {
     isTupleType?: boolean | undefined;
     /**
      * Value is literal type data. BigInt literals are encoded as signed decimal
-     * strings because JSON cannot represent bigint; absent values are null.
+     * strings because JSON cannot represent bigint; absent values are omitted.
      */
-    value: unknown;
+    value?: unknown | undefined;
     /** ObjectType / TypeReference / StringMappingType / IndexType target */
     target?: number | undefined;
     /** InterfaceType type parameters */
@@ -708,7 +708,7 @@ export interface GetSignaturesOfTypeParams {
 
 export interface SignatureResponse {
     id: number;
-    flags: number;
+    flags?: number | undefined;
     declaration?: string | undefined;
     typeParameters?: number[] | undefined;
     parameters?: CompactSymbolReference[] | undefined;
diff --git a/packages/typescript/src/api/sync/api.ts b/packages/typescript/src/api/sync/api.ts
index a296022438..36a14d634d 100644
--- a/packages/typescript/src/api/sync/api.ts
+++ b/packages/typescript/src/api/sync/api.ts
@@ -6686,7 +6686,7 @@ export class Symbol {
         this.escapedName = data.name as __String;
         this.name = unescapeLeadingUnderscores(data.name as __String);
         this.flags = data.flags;
-        this.checkFlags = data.checkFlags;
+        this.checkFlags = data.checkFlags ?? 0;
         // A file-owned symbol has no canonical project; its declarations resolve through its file.
         const project = storage.kind === SymbolOwnerKind.Snapshot ? storage.registry.project : undefined;
         const fileOwner = storage.kind === SymbolOwnerKind.File ? storage.owner : undefined;
@@ -6975,7 +6975,7 @@ class TypeObject implements Type {
 
         this.id = data.id;
         this.flags = data.flags;
-        if (data.objectFlags !== undefined) this.objectFlags = data.objectFlags;
+        this.objectFlags = data.objectFlags ?? 0;
         if (data.symbol !== undefined) this.symbol = data.symbol;
         if (data.value != null) {
             // BigInt literal values are serialized as decimal strings (e.g. "-123") because
@@ -7001,7 +7001,7 @@ class TypeObject implements Type {
             }
         }
         if (data.intrinsicName !== undefined) this.intrinsicName = data.intrinsicName;
-        if (data.isThisType !== undefined) this.isThisType = data.isThisType;
+        this.isThisType = data.isThisType ?? false;
         if (data.freshType !== undefined) this.freshType = data.freshType;
         if (data.regularType !== undefined) this.regularType = data.regularType;
         if (data.target !== undefined) this.target = data.target;
@@ -8007,7 +8007,7 @@ export class Signature {
 
     constructor(data: SignatureResponse, project: Project, objectRegistry: ProjectObjectRegistry) {
         this.id = data.id;
-        this.flags = data.flags;
+        this.flags = data.flags ?? 0;
         this.objectRegistry = objectRegistry;
         this.declaration = data.declaration ? new NodeHandle<Declaration>(data.declaration, project) : undefined;
         this.typeParameters = data.typeParameters ?? [];
diff --git a/tsc/internal/api/proto.go b/tsc/internal/api/proto.go
index 8072445202..130e6b28f7 100644
--- a/tsc/internal/api/proto.go
+++ b/tsc/internal/api/proto.go
@@ -1125,7 +1125,7 @@ type SymbolResponse struct {
 	Reference        SymbolReference         `json:"reference"`
 	Name             string                  `json:"name"`
 	Flags            uint32                  `json:"flags"`
-	CheckFlags       uint32                  `json:"checkFlags"`
+	CheckFlags       uint32                  `json:"checkFlags,omitzero"`
 	Declarations     []NodeHandle            `json:"declarations,omitempty"`
 	ValueDeclaration NodeHandle              `json:"valueDeclaration,omitempty"`
 	Parent           *CompactSymbolReference `json:"parent,omitempty"`
@@ -1176,12 +1176,12 @@ type GetTypesOfSymbolsParams struct {
 type TypeResponse struct {
 	Id          TypeID `json:"id"`
 	Flags       uint32 `json:"flags"`
-	ObjectFlags uint32 `json:"objectFlags,omitempty"`
-	IsTupleType bool   `json:"isTupleType,omitempty"`
+	ObjectFlags uint32 `json:"objectFlags,omitzero"`
+	IsTupleType bool   `json:"isTupleType,omitzero"`
 
 	// Value is literal type data. BigInt literals are encoded as signed decimal
-	// strings because JSON cannot represent bigint; absent values are null.
-	Value any `json:"value"`
+	// strings because JSON cannot represent bigint; absent values are omitted.
+	Value any `json:"value,omitzero"`
 
 	// ObjectType / TypeReference / StringMappingType / IndexType target
 	Target TypeID `json:"target,omitzero"`
@@ -1223,7 +1223,7 @@ type TypeResponse struct {
 	RegularType TypeID `json:"regularType,omitzero"`
 
 	// TypeParameter data
-	IsThisType bool `json:"isThisType,omitempty"`
+	IsThisType bool `json:"isThisType,omitzero"`
 
 	// InterfaceType data
 	ThisType TypeID `json:"thisType,omitzero"`
@@ -1363,7 +1363,7 @@ type ConstantValueResponse struct {
 
 type SignatureResponse struct {
 	Id             SignatureID              `json:"id"`
-	Flags          uint32                   `json:"flags"`
+	Flags          uint32                   `json:"flags,omitzero"`
 	Declaration    NodeHandle               `json:"declaration,omitempty"`
 	TypeParameters []TypeID                 `json:"typeParameters,omitempty"`
 	Parameters     []CompactSymbolReference `json:"parameters,omitempty"`
