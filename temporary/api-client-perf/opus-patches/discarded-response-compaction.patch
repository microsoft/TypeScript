@@ -928,7 +928,8 @@ type ReleaseSourceFileParams struct {
 }
 
 type SourceFileDescriptor struct {
-	FileName        tspath.RootedFilePath `json:"fileName"`
+	// FileName is omitted on the wire when it equals Path.
+	FileName        tspath.RootedFilePath `json:"fileName,omitzero"`
 	Path            tspath.PathKey        `json:"path"`
 	ContentHash     string                `json:"contentHash"`
 	ParseOptionsKey string                `json:"parseOptionsKey"`
@@ -936,6 +937,34 @@ type SourceFileDescriptor struct {
 	NodeID          string                `json:"nodeId"`
 }
 
+// sourceFileDescriptorWire is SourceFileDescriptor without its JSON methods.
+type sourceFileDescriptorWire SourceFileDescriptor
+
+var (
+	_ json.MarshalerTo     = SourceFileDescriptor{}
+	_ json.UnmarshalerFrom = (*SourceFileDescriptor)(nil)
+)
+
+func (d SourceFileDescriptor) MarshalJSONTo(enc *json.Encoder) error {
+	wire := sourceFileDescriptorWire(d)
+	if string(wire.FileName) == string(wire.Path) {
+		wire.FileName = ""
+	}
+	return json.MarshalEncode(enc, &wire)
+}
+
+func (d *SourceFileDescriptor) UnmarshalJSONFrom(dec *json.Decoder) error {
+	var wire sourceFileDescriptorWire
+	if err := json.UnmarshalDecode(dec, &wire); err != nil {
+		return err
+	}
+	if wire.FileName == "" {
+		wire.FileName = tspath.RootedFilePath(wire.Path)
+	}
+	*d = SourceFileDescriptor(wire)
+	return nil
+}
+
 type RetainSourceFileParams struct {
 	File SourceFileDescriptor `json:"file"`
 }
