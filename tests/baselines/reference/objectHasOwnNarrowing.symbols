declare const s: Shape;
>s : Symbol(s, Decl(objectHasOwnNarrowing.ts, 2, 13))
>Shape : Symbol(Shape, Decl(objectHasOwnNarrowing.ts, 0, 0))

if (Object.hasOwn(s, "radius")) {
>Object.hasOwn : Symbol(ObjectConstructor.hasOwn, Decl(lib.es2022.object.d.ts, --, --))
>Object : Symbol(Object, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>hasOwn : Symbol(ObjectConstructor.hasOwn, Decl(lib.es2022.object.d.ts, --, --))
>s : Symbol(s, Decl(objectHasOwnNarrowing.ts, 2, 13))

    s; // narrowed to { kind: "circle"; radius: number }
>s : Symbol(s, Decl(objectHasOwnNarrowing.ts, 2, 13))

    s.radius; // ok
>s.radius : Symbol(radius, Decl(objectHasOwnNarrowing.ts, 1, 30))
>s : Symbol(s, Decl(objectHasOwnNarrowing.ts, 2, 13))
>radius : Symbol(radius, Decl(objectHasOwnNarrowing.ts, 1, 30))
}

