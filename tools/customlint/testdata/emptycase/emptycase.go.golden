	var (
		ch  = make(chan int)
		ch2 = make(chan int)
		ch3 = make(chan int)
		ch4 = make(chan int)
	)
	
	func Select() {
		select {
		case <-ch:
		~~~~~~~~~~
!!! emptycase: this case block is empty and will do nothing
		case <-ch2:
		~~~~~~~~~~~
!!! emptycase: this case block is empty and will do nothing
		case <-ch3:
		~~~~~~~~~~~
!!! emptycase: this case block is empty and will do nothing
		case <-ch4:
			println(`oops`)
		}
