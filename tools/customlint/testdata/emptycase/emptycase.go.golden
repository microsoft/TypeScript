	func SelectCommented() {
		select {
		case <-ch:
			// do nothing
		}
	}
	
	func SelectSingleCase() {
		select {
		case <-ch:
		~~~~~~~~~~
!!! emptycase: this case block is empty and will do nothing
		}
	}
	
	func SelectDefaultCase() {
		select {
		case x := <-ch:
			println(x)
		default:
		~~~~~~~~
!!! emptycase: this case block is empty and will do nothing
		}
	}
	
