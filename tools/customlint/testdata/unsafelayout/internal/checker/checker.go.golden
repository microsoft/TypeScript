	package checker
	
	import "unsafe"
	
	type typeKind uint8
	
	const (
		typeKindLiteral typeKind = iota
		typeKindObject
	)
	
	type Type struct {
		kind typeKind
	}
	
	type LiteralType struct {
		TypeBase
	}
	
	type ObjectType struct {
		TypeBase
	}
	
	type TypeBase struct {
		Type
	}
	
	func (t *TypeBase) AsType() *Type { return &t.Type }
	
	type Checker struct{}
	
	func (c *Checker) newType(flags, objectFlags int, typ *Type, kind typeKind) *Type {
		typ.kind = kind
		if flags != 0 {
			kind := typeKindObject
			typ.kind = kind
			~
!!! unsafelayout: checked construction must initialize the tag from its kind parameter
		}
		return typ
	}
	
	func castType[T any](t *Type, kind typeKind) *T {
		if t.kind != kind {
			panic("Invalid type cast")
		}
		return (*T)(unsafe.Pointer(t))
	}
	
	func calls(c *Checker, literal *LiteralType, typ *Type, kind typeKind) {
		c.newType(0, 0, literal.AsType(), typeKindLiteral)
		c.newType(0, 0, literal.AsType(), typeKindObject)
		~
!!! unsafelayout: newType must directly pair a concrete AsType() receiver with its matching constant kind
		c.newType(0, 0, literal.AsType(), kind)
		~
!!! unsafelayout: newType must directly pair a concrete AsType() receiver with its matching constant kind
		c.newType(0, 0, typ, typeKindLiteral)
		~
!!! unsafelayout: newType must directly pair a concrete AsType() receiver with its matching constant kind
		_ = c.newType
		    ~
!!! unsafelayout: checked construction must be called directly so its allocation/tag pairing can be verified
		_ = castType[LiteralType](typ, typeKindLiteral)
		_ = castType[LiteralType](typ, typeKindObject)
		    ~
!!! unsafelayout: checked cast must directly pair its concrete target type with its matching constant kind
		_ = castType[ObjectType](typ, typeKindLiteral)
		    ~
!!! unsafelayout: checked cast must directly pair its concrete target type with its matching constant kind
		_ = castType[LiteralType](typ, kind)
		    ~
!!! unsafelayout: checked cast must directly pair its concrete target type with its matching constant kind
		_ = castType[*LiteralType](typ, typeKindLiteral)
		    ~
!!! unsafelayout: checked cast must directly pair its concrete target type with its matching constant kind
		_ = castType[LiteralType]
		    ~
!!! unsafelayout: checked cast must directly pair its concrete target type with its matching constant kind
		typ.kind = typeKindLiteral
		~
!!! unsafelayout: type kind is immutable outside checked construction
		typ.kind++
		~
!!! unsafelayout: incrementing a compiler tag bypasses checked tag assignment
		_ = &typ.kind
		    ~
!!! unsafelayout: taking a compiler tag's address bypasses checked tag assignment
		_ = (*LiteralType)(unsafe.Pointer(typ))
		    ~
!!! unsafelayout: reinterpret compiler records only through checked casts or generated AST dispatch
		                   ~
!!! unsafelayout: reinterpret compiler records only through checked casts or generated AST dispatch
	}
	
	type PretendLiteralType struct {
		LiteralType
	}
	
	func (t *PretendLiteralType) AsType() *Type { return &t.Type }
	
	func shadowedUpcast(c *Checker) {
		data := &PretendLiteralType{}
		c.newType(0, 0, data.AsType(), typeKindLiteral)
		~
!!! unsafelayout: newType must directly pair a concrete AsType() receiver with its matching constant kind
	}
	
	type TypeMapperKind uint8
	
	const (
		TypeMapperKindSimple TypeMapperKind = iota
		TypeMapperKindArray
	)
	
	type TypeMapper struct {
		kind TypeMapperKind
	}
	
	type SimpleTypeMapper struct {
		TypeMapper
	}
	
	type ArrayTypeMapper struct {
		TypeMapper
	}
	
	func castTypeMapper[T any](m *TypeMapper, kind TypeMapperKind) *T {
		if m.kind != kind {
			panic("Invalid type mapper cast")
		}
		return (*T)(unsafe.Pointer(m))
	}
	
	func mapperCalls(simple *SimpleTypeMapper, header *TypeMapper) {
		simple.kind = TypeMapperKindSimple
		simple.kind = TypeMapperKindArray
		~
!!! unsafelayout: mapper tag must match the concrete mapper allocation
		header.kind = TypeMapperKindSimple
		~
!!! unsafelayout: mapper tag must match the concrete mapper allocation
		_ = castTypeMapper[SimpleTypeMapper](header, TypeMapperKindSimple)
		_ = castTypeMapper[SimpleTypeMapper](header, TypeMapperKindArray)
		    ~
!!! unsafelayout: checked cast must directly pair its concrete target type with its matching constant kind
		_ = (*SimpleTypeMapper)(unsafe.Pointer(header))
		    ~
!!! unsafelayout: reinterpret compiler records only through checked casts or generated AST dispatch
		                        ~
!!! unsafelayout: reinterpret compiler records only through checked casts or generated AST dispatch
	}
	
	func freshRecords(c *Checker) *Type {
		tagged := &LiteralType{}
		c.newType(0, 0, tagged.AsType(), typeKindLiteral)
		_ = (&LiteralType{}).AsType()
		    ~
!!! unsafelayout: a fresh compiler record must be checked-constructed before it escapes
		escaped := &LiteralType{}
		           ~
!!! unsafelayout: a fresh compiler record must be checked-constructed before it escapes
		c.newType(0, 0, escaped.AsType(), typeKindLiteral)
		_ = escaped.AsType()
		header := &ObjectType{}
		          ~
!!! unsafelayout: a fresh compiler record must be checked-constructed before it escapes
		_ = &header.TypeBase
		c.newType(0, 0, header.AsType(), typeKindObject)
		unused := &ObjectType{}
		          ~
!!! unsafelayout: a fresh compiler record must be checked-constructed before it escapes
		_ = unused
		value := LiteralType{}
		~
!!! unsafelayout: declaring a compiler record by value copies or detaches its tagged header; use a pointer
		         ~
!!! unsafelayout: allocate compiler records by pointer so checked construction can tag them
		_ = value
		    ~
!!! unsafelayout: copying a compiler record by value can detach its tagged header; keep a pointer
		return new(LiteralType).AsType()
		       ~
!!! unsafelayout: a fresh compiler record must be checked-constructed before it escapes
	}
	
	func freshMappers() (*TypeMapper, *TypeMapper) {
		tagged := &SimpleTypeMapper{}
		tagged.kind = TypeMapperKindSimple
		untagged := &ArrayTypeMapper{}
		            ~
!!! unsafelayout: a fresh mapper must be tagged by the statement after its allocation
		return &tagged.TypeMapper, &untagged.TypeMapper
	}
	
	type arena[T any] struct{}
	
	func (a *arena[T]) New() *T { return new(T) }
	
	func arenaRecords(c *Checker, literals *arena[LiteralType]) *LiteralType {
		c.newType(0, 0, literals.New().AsType(), typeKindLiteral)
		data := literals.New()
		c.newType(0, 0, data.AsType(), typeKindLiteral)
		return literals.New()
		       ~
!!! unsafelayout: a fresh compiler record must be checked-constructed before it escapes
	}
	
	func zeroValueRecords() (*LiteralType, *SimpleTypeMapper) {
		var literal LiteralType
		    ~
!!! unsafelayout: a zero-value compiler record bypasses checked construction; use its owning factory
		var literals [2]LiteralType
		    ~
!!! unsafelayout: a zero-value compiler record bypasses checked construction; use its owning factory
		_ = literals
		    ~
!!! unsafelayout: copying a compiler record by value can detach its tagged header; keep a pointer
		var mappers [2]SimpleTypeMapper
		    ~
!!! unsafelayout: a zero-value compiler record bypasses checked construction; use its owning factory
		mappers[0].kind = TypeMapperKindSimple
		return &literal, &mappers[0]
		                 ~
!!! unsafelayout: mapper storage held by value is untagged until an init*TypeMapper function tags it; pass its address there first
	}
	
	func (m *SimpleTypeMapper) Map(t *Type) *Type { return t }
	
	func initSimpleTypeMapper(m *SimpleTypeMapper) *TypeMapper {
		m.kind = TypeMapperKindSimple
		return &m.TypeMapper
	}
	
	type mapperOwner struct {
		mapperStorage [2]SimpleTypeMapper
	}
	
	func coallocatedMappers(owner *mapperOwner, t *Type) (*TypeMapper, *TypeMapper, *Type) {
		tagged := initSimpleTypeMapper(&owner.mapperStorage[0])
		escaped := &owner.mapperStorage[1].TypeMapper
		           ~
!!! unsafelayout: mapper storage held by value is untagged until an init*TypeMapper function tags it; pass its address there first
		return tagged, escaped, owner.mapperStorage[1].Map(t)
		                        ~
!!! unsafelayout: mapper storage held by value is untagged until an init*TypeMapper function tags it; pass its address there first
	}
	
	func zeroValueMapper() *TypeMapper {
		var m SimpleTypeMapper
		    ~
!!! unsafelayout: a zero-value compiler record bypasses checked construction; use its owning factory
		return &m.TypeMapper
		       ~
!!! unsafelayout: mapper storage held by value is untagged until an init*TypeMapper function tags it; pass its address there first
