	package unsafesafety
	
	import "unsafe"
	
	type header struct {
		kind int
	}
	
	type derived struct {
		header
		value int
	}
	
	func bad(h *header, b []byte, s string) {
		_ = (*derived)(unsafe.Pointer(h))
		               ~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
		_ = unsafe.String(&b[0], len(b))
		    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
!!! unsafesafety: use of unsafe.String must be preceded by a `// SAFETY:` comment explaining why it is sound
		_ = unsafe.Slice(unsafe.StringData(s), len(s))
		    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
!!! unsafesafety: use of unsafe.Slice must be preceded by a `// SAFETY:` comment explaining why it is sound
		                 ~~~~~~~~~~~~~~~~~~~~
!!! unsafesafety: use of unsafe.StringData must be preceded by a `// SAFETY:` comment explaining why it is sound
		_ = unsafe.SliceData(b)
		    ~~~~~~~~~~~~~~~~~~~
!!! unsafesafety: use of unsafe.SliceData must be preceded by a `// SAFETY:` comment explaining why it is sound
		_ = unsafe.Add(unsafe.Pointer(h), 1)
		    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
!!! unsafesafety: use of unsafe.Add must be preceded by a `// SAFETY:` comment explaining why it is sound
		               ~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	
		// Not a safety comment.
		_ = (*derived)(unsafe.Pointer(h))
		               ~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	
		// SAFETY: Separated from the use by a blank line.
	
		_ = (*derived)(unsafe.Pointer(h))
		               ~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	
		// safety: Wrong case.
		_ = (*derived)(unsafe.Pointer(h))
		               ~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	
		if h.kind == 1 {
			_ = (*derived)(unsafe.Pointer(h))
			               ~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
		}
	
		_ = unsafe.Pointer(h) // SAFETY: Trailing comments only cover their own line.
		_ = unsafe.Pointer(h)
		    ~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	}
	
	type ptrAlias = unsafe.Pointer
	
	type ptrNamed unsafe.Pointer
	
	func badConversions(p unsafe.Pointer, a ptrAlias, n ptrNamed, h *header) {
		_ = (*int)(p)
		    ~~~~~~~~~
!!! unsafesafety: conversion from unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
		_ = uintptr(p)
		    ~~~~~~~~~~
!!! unsafesafety: conversion from unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
		_ = (*int)(a)
		    ~~~~~~~~~
!!! unsafesafety: conversion from unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
		_ = (*int)(n)
		    ~~~~~~~~~
!!! unsafesafety: conversion from unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
		_ = ptrAlias(h)
		    ~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
		_ = ptrNamed(h)
		    ~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	}
	
	// SAFETY: Comments on a function do not cover its body.
	func badFuncComment(h *header) *derived {
		return (*derived)(unsafe.Pointer(h))
		                  ~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	}
	
	func good(h *header, b []byte, p unsafe.Pointer) {
		// SAFETY: h is always embedded in a derived.
		_ = (*derived)(unsafe.Pointer(h))
	
		_ = (*derived)(unsafe.Pointer(h)) // SAFETY: Trailing comment.
	
		/* SAFETY: Block comment. */
		_ = (*derived)(unsafe.Pointer(h))
	
		// Multiple lines of explanation are fine,
		// SAFETY: as long as one starts with SAFETY.
		// More text.
		_ = (*derived)(unsafe.Pointer(h))
	
		// SAFETY: One comment covers the whole statement.
		_ = unsafe.Slice((*byte)(unsafe.Pointer(h)), unsafe.Sizeof(*h))
	
		// SAFETY: Covers the if statement, including its init.
		if p := (*derived)(unsafe.Pointer(h)); p != nil {
			_ = p
		}
	
		use(
			1,
			// SAFETY: Comment directly above an argument.
			unsafe.Pointer(h),
		)
	
		switch h.kind {
		case 1:
			// SAFETY: Inside a case clause.
			_ = (*derived)(unsafe.Pointer(h))
		}
	
		// SAFETY: Conversions from unsafe.Pointer need justification too.
		_ = (*derived)(p)
	
		// Compile-time operations are always safe.
		_ = unsafe.Sizeof(*h)
		_ = unsafe.Alignof(*h)
		_ = unsafe.Offsetof(derived{}.value)
	}
	
	// Using unsafe.Pointer as a type is not itself unsafe.
	func use(_ int, p unsafe.Pointer) unsafe.Pointer {
		return p
	}
	
	// SAFETY: Package-level declarations are covered too.
	var global = unsafe.Pointer(&derived{})
	
	var badGlobal = unsafe.Pointer(&derived{})
	                ~~~~~~~~~~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	
	func multiline(h *header) {
		_ = unsafe.Pointer(
			h,
		) // SAFETY: Trailing the end of a multiline use.
	
		if (*derived)(unsafe.Pointer(h)) != nil {
		              ~~~~~~~~~~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
		} // SAFETY: Trailing a statement's end does not cover its start.
	}
	
	func fromTypeParam[P ~unsafe.Pointer](p P) *int {
		return (*int)(p)
		       ~~~~~~~~~
!!! unsafesafety: conversion from unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	}
	
	func toTypeParam[P ~unsafe.Pointer](p *int) P {
		return P(p)
		       ~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	}
	
	type pointerish interface {
		~unsafe.Pointer | *int
	}
	
	func embeddedConstraint[P pointerish](p *int) P {
		// SAFETY: Type parameters whose type set includes unsafe.Pointer count.
		return P(p)
	}
	
	func notPointerTypeParam[P ~*int](p *int) P {
		return P(p)
	}
	
	func aliasedTypeParam[P ~unsafe.Pointer](p *int, q P) {
		type Alias = P
		_ = Alias(p)
		    ~~~~~~~~
!!! unsafesafety: conversion to unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
		var a Alias = q
		_ = (*int)(a)
		    ~~~~~~~~~
!!! unsafesafety: conversion from unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	}
	
	type onlyUintptr interface {
		~unsafe.Pointer | ~uintptr
		~uintptr
	}
	
	func intersectedConstraint[P onlyUintptr](p P) uintptr {
		return uintptr(p)
	}
	
	type ptrOrUintptr interface {
		~unsafe.Pointer | ~uintptr
	}
	
	type diamond interface {
		ptrOrUintptr
		interface{ ptrOrUintptr }
	}
	
	func diamondConstraint[P diamond](p P) uintptr {
		return uintptr(p)
		       ~~~~~~~~~~
!!! unsafesafety: conversion from unsafe.Pointer must be preceded by a `// SAFETY:` comment explaining why it is sound
	}
	
	func boxing[P ~unsafe.Pointer](p P, q unsafe.Pointer) {
		_ = any(p)
		_ = any(q)
	}
	
