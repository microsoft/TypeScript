import fs from "node:fs";
import path from "node:path";
import ts from "typescript";
import { repoRoot } from "./utils.mts";

const oldApiPath = path.join(repoRoot, "node_modules", "typescript", "lib", "typescript.d.ts");
const outputPath = path.join(repoRoot, "tsc", "testdata", "apiold.txt");
const typescriptVersion = JSON.parse(
    fs.readFileSync(path.join(repoRoot, "node_modules", "typescript", "package.json"), "utf8"),
).version as string;
const types = getTypesWithMethods(oldApiPath);

const report = [
    "# Types in the old API that declare public methods.",
    "# This report is generated by tools/scripts/gen/apiold.mts.",
    `# Old API: TypeScript ${typescriptVersion} (node_modules/typescript/lib/typescript.d.ts)`,
    "",
];

for (const [type, methods] of types) {
    report.push(`## ${type} ##`, ...methods, "");
}

fs.writeFileSync(outputPath, report.join("\n"));

function getTypesWithMethods(file: string): Map<string, string[]> {
    const sourceFile = ts.createSourceFile(
        file,
        fs.readFileSync(file, "utf8"),
        ts.ScriptTarget.Latest,
        true,
    );
    const types = new Map<string, Set<string>>();
    visit(sourceFile, []);

    return new Map(
        [...types]
            .map(([type, methods]) => [type, [...methods].sort()] as const)
            .sort(([left], [right]) => left.localeCompare(right)),
    );

    function visit(node: ts.Node, namespace: readonly string[]): void {
        const childNamespace = ts.isModuleDeclaration(node)
            ? [...namespace, getModuleName(node.name)]
            : namespace;
        const type = getTypeDeclaration(node);
        if (type) {
            const methods = getPublicMethods(type.members);
            if (methods.size > 0) {
                const qualifiedName = [...namespace, type.name.text].join(".");
                const existing = types.get(qualifiedName);
                if (existing) {
                    for (const method of methods) existing.add(method);
                }
                else {
                    types.set(qualifiedName, methods);
                }
            }
        }
        ts.forEachChild(node, child => visit(child, childNamespace));
    }
}

type NamedTypeDeclaration = (ts.ClassDeclaration | ts.InterfaceDeclaration) & { name: ts.Identifier; };

function getTypeDeclaration(node: ts.Node): NamedTypeDeclaration | undefined {
    if (
        (ts.isClassDeclaration(node) || ts.isInterfaceDeclaration(node))
        && node.name
    ) {
        return node as NamedTypeDeclaration;
    }
    return undefined;
}

function getPublicMethods(members: ts.NodeArray<ts.TypeElement | ts.ClassElement>): Set<string> {
    const methods = new Set<string>();
    for (const member of members) {
        if (
            (ts.isMethodDeclaration(member) || ts.isMethodSignature(member))
            && !hasModifier(member, ts.SyntaxKind.PrivateKeyword)
            && !hasModifier(member, ts.SyntaxKind.ProtectedKeyword)
        ) {
            const name = getPropertyName(member.name);
            if (name !== undefined) methods.add(name);
        }
    }
    return methods;
}

function getModuleName(name: ts.ModuleName): string {
    return name.text;
}

function hasModifier(node: ts.Node, kind: ts.SyntaxKind): boolean {
    return ts.canHaveModifiers(node) && ts.getModifiers(node)?.some(modifier => modifier.kind === kind) === true;
}

function getPropertyName(name: ts.PropertyName): string | undefined {
    if (ts.isIdentifier(name) || ts.isStringLiteral(name) || ts.isNumericLiteral(name)) {
        return name.text;
    }
    return undefined;
}
