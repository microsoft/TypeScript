>handler : Symbol(handler, Decl(assertionCallCycleCheckOrder.ts, 5, 15))
>date : Symbol(date, Decl(assertionCallCycleCheckOrder.ts, 5, 25))
>T : Symbol(T, Decl(assertionCallCycleCheckOrder.ts, 4, 19))
    }
}

const theClass: GenericClass<typeof handlers> = new GenericClass();
>theClass : Symbol(theClass, Decl(assertionCallCycleCheckOrder.ts, 9, 5))
>GenericClass : Symbol(GenericClass, Decl(assertionCallCycleCheckOrder.ts, 0, 0))
>handlers : Symbol(handlers, Decl(assertionCallCycleCheckOrder.ts, 12, 5))
>GenericClass : Symbol(GenericClass, Decl(assertionCallCycleCheckOrder.ts, 0, 0))

theClass.setHandler(() => {});
