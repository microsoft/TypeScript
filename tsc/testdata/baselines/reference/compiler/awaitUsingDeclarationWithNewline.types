>resource : AsyncDisposable

declare const resources: Iterable<AsyncDisposable>;
>resources : Iterable<AsyncDisposable>

async function statement() {
>statement : () => Promise<void>

    await
>await    using : any

    using x = resource;
>using : any
>x = resource : AsyncDisposable
>x : any
>resource : AsyncDisposable
}

async function forStatement() {
>forStatement : () => Promise<void>

    for (await
>await        using : any

        using x = resource; ;) {}
>using : any
>x = resource : AsyncDisposable
