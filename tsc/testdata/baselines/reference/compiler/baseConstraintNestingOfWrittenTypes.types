>box(box(box(""))) : Box<Box<Box<string>>>
>box : <T>(value: T) => Box<T>
>box(box("")) : Box<Box<string>>
>box : <T>(value: T) => Box<T>
>box("") : Box<string>
>box : <T>(value: T) => Box<T>
>"" : ""

type Like<Base, Candidate> = keyof Base extends keyof Candidate ? Base : never;
>Like : Like<Base, Candidate>

function nested<R extends Like<typeof box5, R>>(r: R) {
>nested : <R extends Like<typeof box5, R>>(r: R) => void
>box5 : Box<Box<Box<Box<Box<string>>>>>
>r : R

    r.value;
>r.value : Box<Box<Box<Box<string>>>>
>r : R
>value : Box<Box<Box<Box<string>>>>
}
