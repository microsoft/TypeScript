// From ariakit, whose recipes nest recipes made by function calls.
interface Box<T> {
    value: T;
>value : T
}
declare function box<T>(value: T): Box<T>;
>box : <T>(value: T) => Box<T>
>value : T

const box5 = box(box(box(box(box("")))));
>box5 : Box<Box<Box<Box<Box<string>>>>>
>box(box(box(box(box(""))))) : Box<Box<Box<Box<Box<string>>>>>
>box : <T>(value: T) => Box<T>
