>(id) => {    id.toFixed();    return "John Doe";} : (id: number) => string
>id : number

    id.toFixed();
>id.toFixed() : string
>id.toFixed : (fractionDigits?: number) => string
>id : number
>toFixed : (fractionDigits?: number) => string

    return "John Doe";
>"John Doe" : "John Doe"

};

