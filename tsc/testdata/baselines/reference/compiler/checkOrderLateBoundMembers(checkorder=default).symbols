//// [tests/cases/compiler/checkOrderLateBoundMembers.ts] ////

=== checkOrderLateBoundMembers.ts ===
// Resolving the name in a computed property name looks it up in the members
// of the enclosing interface. That must not late-bind those same members,
// or the accessors would not merge with the property when asked first.
const foo = "foo"
>foo : Symbol(foo, Decl(checkOrderLateBoundMembers.ts, 3, 5))

interface I {
>I : Symbol(I, Decl(checkOrderLateBoundMembers.ts, 3, 17))

    get [foo](): number;
>[foo] : Symbol(I.foo, Decl(checkOrderLateBoundMembers.ts, 5, 24), Decl(checkOrderLateBoundMembers.ts, 4, 13), Decl(checkOrderLateBoundMembers.ts, 6, 16))
>foo : Symbol(foo, Decl(checkOrderLateBoundMembers.ts, 3, 5))

    foo: number;
>foo : Symbol(I.foo, Decl(checkOrderLateBoundMembers.ts, 5, 24), Decl(checkOrderLateBoundMembers.ts, 4, 13), Decl(checkOrderLateBoundMembers.ts, 6, 16))

    set [foo](value: number);
>[foo] : Symbol(I.foo, Decl(checkOrderLateBoundMembers.ts, 5, 24), Decl(checkOrderLateBoundMembers.ts, 4, 13), Decl(checkOrderLateBoundMembers.ts, 6, 16))
>foo : Symbol(foo, Decl(checkOrderLateBoundMembers.ts, 3, 5))
>value : Symbol(value, Decl(checkOrderLateBoundMembers.ts, 7, 14))
}

