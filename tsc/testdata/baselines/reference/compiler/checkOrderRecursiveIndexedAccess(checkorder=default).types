=== recur.ts ===
export type Recur<T> =
>Recur : Recur<T>

    (T extends  (unknown[]) ? {} : { [K in keyof T]?: Recur<T[K]>}) |
    [...Recur<T>[number][]];

=== join.ts ===
import { Recur } from "./recur";
>Recur : any

export function join<T>(l: Recur<T>[]): Recur<T> {
>join : <T>(l: Recur<T>[]) => Recur<T>
>l : Recur<T>[]

    return ['marker', ...l];
>['marker', ...l] : [string, ...Recur<T>[]]
>'marker' : "marker"
>...l : Recur<T>
>l : Recur<T>[]
}

=== a.ts ===
