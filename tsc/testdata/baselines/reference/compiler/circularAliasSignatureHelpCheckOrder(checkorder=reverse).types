//// [tests/cases/compiler/circularAliasSignatureHelpCheckOrder.ts] ////

=== circularAliasSignatureHelpCheckOrder.ts ===
// Signature help for the call resolves the circular aliases inside a request
// whose effects are discarded. Checking afterwards still reports both
// circularities (58068).

type A = B;
>A : any

type B = A;
>B : any

declare function f(x: A): void;
>f : (x: A) => void
>x : any

f(1);
>f(1) : void
>f : (x: A) => void
>1 : 1

