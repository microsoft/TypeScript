//// [tests/cases/compiler/circularReturnTypeInstantiationCheckOrder.ts] ////

=== circularReturnTypeInstantiationCheckOrder.ts ===
// Requested first, rebuild's return type is resolved as if b's, which the
// relation of subtype reduction requests through its instantiation for this,
// had been resolved first. Neither member is circular in any order.
interface A {
    b(): A;
>b : () => A

    c: A;
>c : A
}
declare const flag: boolean;
>flag : boolean

const A: new () => A = class {
>A : new () => A
>class {    rebuild() {        return flag ? this : new A();    }    b() {        return this.rebuild();    }    c() {        return this.rebuild;    }} : typeof A

    rebuild() {
>rebuild : () => this | A

        return flag ? this : new A();
>flag ? this : new A() : this | A
>flag : boolean
>this : this
>new A() : A
>A : new () => A
    }
    b() {
>b : () => this | A

        return this.rebuild();
>this.rebuild() : this | A
>this.rebuild : () => this | A
>this : this
>rebuild : () => this | A
    }
    c() {
>c : () => () => this | A

        return this.rebuild;
>this.rebuild : () => this | A
>this : this
>rebuild : () => this | A
    }
};
export {};

