=== expression.ts ===
// Subtype reduction of rebuild's return type relates the class to A,
// which needs b's return type, which needs rebuild's: a cycle. Both
// members report it, whichever return type is requested first, as if
// rebuild's, declared first, were requested first.
interface A {
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 9, 5))

    b(): A;
>b : Symbol(A.b, Decl(expression.ts, 4, 13))
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 9, 5))

    c: A;
>c : Symbol(A.c, Decl(expression.ts, 5, 11))
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 9, 5))
}
declare const flag: boolean;
>flag : Symbol(flag, Decl(expression.ts, 8, 13))

const A: new () => A = class {
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 9, 5))
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 9, 5))

    rebuild() {
>rebuild : Symbol(A.rebuild, Decl(expression.ts, 9, 30))

        return flag ? this : new A();
>flag : Symbol(flag, Decl(expression.ts, 8, 13))
>this : Symbol(A, Decl(expression.ts, 9, 22))
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 9, 5))
    }
    b() {
>b : Symbol(A.b, Decl(expression.ts, 12, 5))

        return this.rebuild();
>this.rebuild : Symbol(A.rebuild, Decl(expression.ts, 9, 30))
>this : Symbol(A, Decl(expression.ts, 9, 22))
>rebuild : Symbol(A.rebuild, Decl(expression.ts, 9, 30))
    }
    c() {
>c : Symbol(A.c, Decl(expression.ts, 15, 5))

        return this.rebuild;
>this.rebuild : Symbol(A.rebuild, Decl(expression.ts, 9, 30))
>this : Symbol(A, Decl(expression.ts, 9, 22))
>rebuild : Symbol(A.rebuild, Decl(expression.ts, 9, 30))
    }
};
export {};

