//// [tests/cases/compiler/circularReturnTypeSubtypeReductionOrder.ts] ////

=== expression.ts ===
// Subtype reduction of rebuild's return type relates the class to A,
// which needs b's return type, which needs rebuild's: a cycle. The
// relation only observes b's return type in progress, so resolving b's
// first does not fail, and neither member is circular, whichever return
// type is requested first.
interface A {
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 10, 5))

    b(): A;
>b : Symbol(A.b, Decl(expression.ts, 5, 13))
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 10, 5))

    c: A;
>c : Symbol(A.c, Decl(expression.ts, 6, 11))
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 10, 5))
}
declare const flag: boolean;
>flag : Symbol(flag, Decl(expression.ts, 9, 13))

const A: new () => A = class {
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 10, 5))
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 10, 5))

    rebuild() {
>rebuild : Symbol(A.rebuild, Decl(expression.ts, 10, 30))

        return flag ? this : new A();
>flag : Symbol(flag, Decl(expression.ts, 9, 13))
>this : Symbol(A, Decl(expression.ts, 10, 22))
>A : Symbol(A, Decl(expression.ts, 0, 0), Decl(expression.ts, 10, 5))
    }
    b() {
>b : Symbol(A.b, Decl(expression.ts, 13, 5))

        return this.rebuild();
>this.rebuild : Symbol(A.rebuild, Decl(expression.ts, 10, 30))
>this : Symbol(A, Decl(expression.ts, 10, 22))
>rebuild : Symbol(A.rebuild, Decl(expression.ts, 10, 30))
    }
    c() {
>c : Symbol(A.c, Decl(expression.ts, 16, 5))

        return this.rebuild;
>this.rebuild : Symbol(A.rebuild, Decl(expression.ts, 10, 30))
>this : Symbol(A, Decl(expression.ts, 10, 22))
>rebuild : Symbol(A.rebuild, Decl(expression.ts, 10, 30))
    }
};
export {};

