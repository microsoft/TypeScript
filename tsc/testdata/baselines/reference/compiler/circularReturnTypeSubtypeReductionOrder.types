//// [tests/cases/compiler/circularReturnTypeSubtypeReductionOrder.ts] ////

=== expression.ts ===
// Subtype reduction of rebuild's return type relates the class to A,
// which needs b's return type, which needs rebuild's: a cycle. The
// relation only observes b's return type in progress, so resolving b's
// first does not fail, and neither member is circular, whichever return
// type is requested first.
interface A {
    b(): A;
>b : () => A

    c: A;
>c : A
}
declare const flag: boolean;
>flag : boolean

const A: new () => A = class {
>A : new () => A
>class {    rebuild() {        return flag ? this : new A();    }    b() {        return this.rebuild();    }    c() {        return this.rebuild;    }} : typeof A

    rebuild() {
>rebuild : () => this | A

        return flag ? this : new A();
>flag ? this : new A() : this | A
>flag : boolean
>this : this
>new A() : A
>A : new () => A
    }
    b() {
>b : () => this | A

        return this.rebuild();
>this.rebuild() : this | A
>this.rebuild : () => this | A
>this : this
>rebuild : () => this | A
    }
    c() {
>c : () => () => this | A

        return this.rebuild;
>this.rebuild : () => this | A
>this : this
>rebuild : () => this | A
    }
};
export {};

=== declaration.ts ===
interface B {
    b(): B;
>b : () => B
}
declare const flag: boolean;
>flag : boolean

class K {
>K : K

    rebuild() {
>rebuild : () => B

        return flag ? this : new B();
>flag ? this : new B() : B
>flag : boolean
>this : this
>new B() : B
>B : new () => B
    }
    b() {
>b : () => B

        return this.rebuild();
>this.rebuild() : B
>this.rebuild : () => B
>this : this
>rebuild : () => B
    }
}
const B: new () => B = K;
>B : new () => B
>K : typeof K

export {};

=== declaredLater.ts ===
// The same, with the member the relation requests declared first.
interface D {
    b(): D;
>b : () => D
}
declare const flag: boolean;
>flag : boolean

const D: new () => D = class {
>D : new () => D
>class {    b() {        return this.rebuild();    }    rebuild() {        return flag ? this : new D();    }} : typeof D

    b() {
>b : () => D

        return this.rebuild();
>this.rebuild() : D
>this.rebuild : () => D
>this : this
>rebuild : () => D
    }
    rebuild() {
>rebuild : () => D

        return flag ? this : new D();
>flag ? this : new D() : D
>flag : boolean
>this : this
>new D() : D
>D : new () => D
    }
};
export {};

