type Resolve<T> = T extends () => infer R ? R : T;
>Resolve : Resolve<T>

type Validate<def> = { [K in keyof def]: def[K] extends () => infer R ? () => R : def[K] };
>Validate : Validate<def>

interface Scope<def> {
    type<k extends keyof def>(k: k): Resolve<def[k]>;
>type : <k extends keyof def>(k: k) => Resolve<def[k]>
>k : k
}
interface Type<T> {
    pipe<U>(f: (x: T) => U): Type<U>;
>pipe : <U>(f: (x: T) => U) => Type<U>
>f : (x: T) => U
>x : T
}
declare function scope<const def>(def: Validate<def>): Scope<def>;
>scope : <const def>(def: Validate<def>) => Scope<def>
>def : Validate<def>

declare function type<T>(x: T): Type<T>;
>type : <T>(x: T) => Type<T>
>x : T

export const $ = scope({
>$ : Scope<{ a: Type<number>; b: unknown; }>
>scope({    a: type("string").pipe(function (s) { return s.length; }),    b: () => $.type("a").pipe(function (n) { return n === 0; }),}) : Scope<{ a: Type<number>; b: unknown; }>
