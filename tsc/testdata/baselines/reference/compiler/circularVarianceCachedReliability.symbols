//// [tests/cases/compiler/circularVarianceCachedReliability.ts] ////

=== circularVarianceCachedReliability.ts ===
// Repro for #64995. When variance measurement restarts because of a circularity, probes for the same
// marker types are answered from the relation cache. The cached `Unmeasurable` reliability flag must be
// propagated, otherwise `Lnk` and `Api` are measured as plain invariant (no structural fallback) and the
// assignment below is wrongly rejected.

declare class Fld<T extends object> { f: T }
>Fld : Symbol(Fld, Decl(circularVarianceCachedReliability.ts, 0, 0))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 5, 18))
>f : Symbol(Fld.f, Decl(circularVarianceCachedReliability.ts, 5, 37))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 5, 18))

type Sel<T extends object> = T extends { v: 2 } ? Lnk<T> | Fld<T> : T extends { v: 4 } ? Fld<T> : never;
>Sel : Symbol(Sel, Decl(circularVarianceCachedReliability.ts, 5, 44))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 6, 9))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 6, 9))
>v : Symbol(v, Decl(circularVarianceCachedReliability.ts, 6, 40))
>Lnk : Symbol(Lnk, Decl(circularVarianceCachedReliability.ts, 11, 58))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 6, 9))
>Fld : Symbol(Fld, Decl(circularVarianceCachedReliability.ts, 0, 0))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 6, 9))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 6, 9))
>v : Symbol(v, Decl(circularVarianceCachedReliability.ts, 6, 79))
>Fld : Symbol(Fld, Decl(circularVarianceCachedReliability.ts, 0, 0))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 6, 9))

