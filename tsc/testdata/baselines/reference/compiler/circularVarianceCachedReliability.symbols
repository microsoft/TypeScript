>Api : Symbol(Api, Decl(circularVarianceCachedReliability.ts, 6, 104))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 7, 14))

  rb(): Rb<T>;
>rb : Symbol(Api.rb, Decl(circularVarianceCachedReliability.ts, 7, 33))
>Rb : Symbol(Rb, Decl(circularVarianceCachedReliability.ts, 10, 1))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 7, 14))

  builder: { [K in keyof T]-?: (value: T[K]) => void };
>builder : Symbol(Api.builder, Decl(circularVarianceCachedReliability.ts, 8, 14))
>K : Symbol(K, Decl(circularVarianceCachedReliability.ts, 9, 14))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 7, 14))
>value : Symbol(value, Decl(circularVarianceCachedReliability.ts, 9, 32))
>T : Symbol(T, Decl(circularVarianceCachedReliability.ts, 7, 14))
>K : Symbol(K, Decl(circularVarianceCachedReliability.ts, 9, 14))
}
