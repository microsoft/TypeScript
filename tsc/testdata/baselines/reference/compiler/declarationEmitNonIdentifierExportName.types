//// [tests/cases/compiler/declarationEmitNonIdentifierExportName.ts] ////

=== dep.ts ===
interface A { x: number }
>x : number

interface C { y: number }
>y : number

export { A as "a b", C as "a c", C as Ok };
>A : any
>"a b" : any
>C : any
>"a c" : any
>C : any
>Ok : any

=== mid.ts ===
import { "a b" as B, "a c" as C } from "./dep";
>B : any
>C : any

export declare function f(): B;
>f : () => B

export declare function g(): C;
>g : () => C

=== main.ts ===
import { f, g } from "./mid";
>f : () => import("./dep.js").a b
>g : () => import("./dep.js").a c

export const v = f();
>v : import("./dep").a b
>f() : import("./dep").a b
>f : () => import("./dep").a b

export const w = g();
>w : import("./dep").a c
>g() : import("./dep").a c
>g : () => import("./dep").a c

