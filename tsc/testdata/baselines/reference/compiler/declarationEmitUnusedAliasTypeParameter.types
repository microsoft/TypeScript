declare const names: "alice" | "bob" | Loose<"user">;
>names : "alice" | "bob" | Loose<Label>

declare const relabeled: Relabeled<"user">;
>relabeled : number

declare const partly: UsesSecond<"user", 1>;
>partly : UsesSecond<"user", 1>

export const copy = item;
>copy : Labeled<Label>
>item : Labeled<Label>

export const inferred = id(item);
>inferred : Labeled<Label>
>id(item) : Labeled<Label>
>id : <T>(value: T) => T
>item : Labeled<Label>

export const fromCall = label<"admin">("admin");
>fromCall : Labeled<Label>
>label<"admin">("admin") : Labeled<Label>
