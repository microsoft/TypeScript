type OnlyNumber<T extends number> = T;
>OnlyNumber : T

type BothBranches<T extends string | number> =
>BothBranches : BothBranches<T>

    T extends string ? { branch: "true"; value: OnlyString<T> } : { branch: "false"; value: OnlyNumber<T> };
>branch : "true"
>value : T
>branch : "false"
>value : T

const trueBranch: BothBranches<string | number> = { branch: "true", value: "value" };
>trueBranch : { branch: "true"; value: string; } | { branch: "false"; value: number; }
>{ branch: "true", value: "value" } : { branch: "true"; value: string; }
>branch : "true"
>"true" : "true"
>value : string
>"value" : "value"

const falseBranch: BothBranches<string | number> = { branch: "false", value: 1 };
>falseBranch : { branch: "true"; value: string; } | { branch: "false"; value: number; }
>{ branch: "false", value: 1 } : { branch: "false"; value: number; }
>branch : "false"
>"false" : "false"
>value : number
>1 : 1

type DifferentParameters<T, U> = T extends string ? U extends number ? [OnlyNumber<U>, OnlyString<T>] : never : never;
>DifferentParameters : DifferentParameters<T, U>

