>runMachine : <TDefinition extends { initial: { state: keyof TDefinition["transitions"]; context: object; }; transitions: { [TState in keyof TDefinition["transitions"]]: (current: { context: MapNeverToAny<Context<TDefinition, TState>>; }) => void | { state: keyof TDefinition["transitions"]; context: object; }; }; }>(definition: TDefinition) => { [S in keyof TDefinition["transitions"]]: { state: S; context: Context<TDefinition, S>; }; }[keyof TDefinition["transitions"]]

  <TDefinition extends {
    initial: {
>initial : { state: keyof TDefinition["transitions"]; context: object; }

      state: keyof TDefinition["transitions"],
>state : keyof TDefinition["transitions"]

      context: object
>context : object

    },
    transitions: {
>transitions : { [TState in keyof TDefinition["transitions"]]: (current: { context: MapNeverToAny<Context<TDefinition, TState>>; }) => void | { state: keyof TDefinition["transitions"]; context: object; }; }

      [TState in keyof TDefinition["transitions"]]:
        (current: { context: MapNeverToAny<Context<TDefinition, TState>> }) =>
>current : { context: MapNeverToAny<Context<TDefinition, TState>>; }
>context : MapNeverToAny<Context<TDefinition, TState>>

          | void
          | { state: keyof TDefinition["transitions"], context: object }
>state : keyof TDefinition["transitions"]
>context : object
    }
  }>
    (definition: TDefinition) =>
>definition : TDefinition

