>args : Symbol(args, Decl(distributiveConstraintOfCircularCheckType.ts, 11, 51))
>Parameters : Symbol(Parameters, Decl(lib.es5.d.ts, --, --))
>Collect : Symbol(Collect, Decl(distributiveConstraintOfCircularCheckType.ts, 0, 0))
>F : Symbol(F, Decl(distributiveConstraintOfCircularCheckType.ts, 11, 14))
>f : Symbol(f, Decl(distributiveConstraintOfCircularCheckType.ts, 11, 89))
