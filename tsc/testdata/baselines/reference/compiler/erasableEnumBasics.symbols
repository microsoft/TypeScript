const existingValue = "exists";
>existingValue : Symbol(existingValue, Decl(erasableEnumBasics.ts, 0, 5))

const E: enum = {
>E : Symbol(E, Decl(erasableEnumBasics.ts, 1, 5))

    Existing: existingValue,
>Existing : Symbol(E.Existing, Decl(erasableEnumBasics.ts, 1, 17))
>existingValue : Symbol(existingValue, Decl(erasableEnumBasics.ts, 0, 5))

    Int: 1,
>Int : Symbol(E.Int, Decl(erasableEnumBasics.ts, 2, 28))

    String: "string",
>String : Symbol(E.String, Decl(erasableEnumBasics.ts, 3, 11))

    Flag: 8,
>Flag : Symbol(E.Flag, Decl(erasableEnumBasics.ts, 4, 21))

};

// Members are assignable to their enum type and their own member type.
let value: E = E.Existing;
>value : Symbol(value, Decl(erasableEnumBasics.ts, 9, 3))
>E : Symbol(E, Decl(erasableEnumBasics.ts, 1, 5))
>E.Existing : Symbol(E.Existing, Decl(erasableEnumBasics.ts, 1, 17))
