>Int : Symbol(E.Int, Decl(erasableEnumBasics.ts, 2, 28))

intMember = E.Flag; // error: a different known member.
>intMember : Symbol(intMember, Decl(erasableEnumBasics.ts, 12, 3))
>E.Flag : Symbol(E.Flag, Decl(erasableEnumBasics.ts, 4, 21))
>E : Symbol(E, Decl(erasableEnumBasics.ts, 1, 5))
>Flag : Symbol(E.Flag, Decl(erasableEnumBasics.ts, 4, 21))

// Matching numeric literals are accepted, but other known literals are rejected.
value = 1;
>value : Symbol(value, Decl(erasableEnumBasics.ts, 9, 3))

value = 4; // error
>value : Symbol(value, Decl(erasableEnumBasics.ts, 9, 3))

// String members retain nominal types, including values from constant references.
value = "exists"; // error
>value : Symbol(value, Decl(erasableEnumBasics.ts, 9, 3))

value = "string"; // error
>value : Symbol(value, Decl(erasableEnumBasics.ts, 9, 3))

const Other: enum = { String: "string" };
>Other : Symbol(Other, Decl(erasableEnumBasics.ts, 22, 5))
>String : Symbol(Other.String, Decl(erasableEnumBasics.ts, 22, 21))

value = Other.String; // error: members from different enums are incompatible.
>value : Symbol(value, Decl(erasableEnumBasics.ts, 9, 3))
>Other.String : Symbol(Other.String, Decl(erasableEnumBasics.ts, 22, 21))
>Other : Symbol(Other, Decl(erasableEnumBasics.ts, 22, 5))
