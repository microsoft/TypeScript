//// [tests/cases/compiler/exportStarNameCollisions.ts] ////

=== a.ts ===
export const onlyA = 1;
>onlyA : Symbol(onlyA, Decl(a.ts, 0, 12))

export const shared = "a";
>shared : Symbol(shared, Decl(a.ts, 1, 12))

export interface SharedType { fromA: true }
>SharedType : Symbol(SharedType, Decl(a.ts, 1, 26))
>fromA : Symbol(SharedType.fromA, Decl(a.ts, 2, 29))

export default "a";

=== b.ts ===
export const onlyB = 2;
>onlyB : Symbol(onlyB, Decl(b.ts, 0, 12))

export const shared = "b";
>shared : Symbol(shared, Decl(b.ts, 1, 12))

export interface SharedType { fromB: true }
>SharedType : Symbol(SharedType, Decl(b.ts, 1, 26))
>fromB : Symbol(SharedType.fromB, Decl(b.ts, 2, 29))

export default "b";

=== b2.ts ===
export const shared = "b2";
>shared : Symbol(shared, Decl(b2.ts, 0, 12))

=== sameSymbol.ts ===
export { shared } from "./a";
>shared : Symbol(shared, Decl(sameSymbol.ts, 0, 8))

=== twoStarsCollide.ts ===

// 'shared' and 'SharedType' come from both modules with different meanings.
export * from "./a";
export * from "./b";

=== threeStarsCollide.ts ===

// Both later declarations are reported against the first one.
export * from "./a";
export * from "./b";
export * from "./b2";

=== sameSymbolTwice.ts ===

// Reaching the same symbol through two declarations is not a collision.
export * from "./a";
export * from "./sameSymbol";

=== localShadows.ts ===
// A module's own export takes precedence and silences the collision for shared, but not for SharedType.
export * from "./a";
export * from "./b";
export const shared = "local";
>shared : Symbol(shared, Decl(localShadows.ts, 3, 12))

=== singleStar.ts ===

export * from "./a";

=== typeOnlyThenValue.ts ===

export type * from "./a";
export * from "./b";

=== valueThenTypeOnly.ts ===

export * from "./a";
export type * from "./b";

=== chained.ts ===

export * from "./twoStarsCollide";
export * from "./singleStar";

=== consumer.ts ===
