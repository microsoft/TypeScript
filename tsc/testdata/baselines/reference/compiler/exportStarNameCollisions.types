>onlyB : 2
>b6 : 2

import { onlyA as a7, onlyB as b7, shared as s7 } from "./chained";
>onlyA : 1
>a7 : 1
>onlyB : 2
>b7 : 2
>shared : "a"
>s7 : "a"

import type { SharedType } from "./twoStarsCollide";
