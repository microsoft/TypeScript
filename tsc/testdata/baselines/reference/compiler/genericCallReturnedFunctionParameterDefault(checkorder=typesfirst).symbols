>id : Symbol(id, Decl(genericCallReturnedFunctionParameterDefault.ts, 0, 0))

    return (x = false) => {};
>x : Symbol(x, Decl(genericCallReturnedFunctionParameterDefault.ts, 11, 12))

});

id(() => (y = false) => y);
