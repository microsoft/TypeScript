>T : Symbol(T, Decl(genericCallReturnedFunctionParameterDefault.ts, 8, 20))
>callback : Symbol(callback, Decl(genericCallReturnedFunctionParameterDefault.ts, 8, 23))
>T : Symbol(T, Decl(genericCallReturnedFunctionParameterDefault.ts, 8, 20))
>T : Symbol(T, Decl(genericCallReturnedFunctionParameterDefault.ts, 8, 20))

