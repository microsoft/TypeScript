=== genericContextualComposition.ts ===
type Enhancer<Extension extends {} = {}> = <Next extends {}>(next: Next) => Next & Extension;
>Enhancer : Enhancer<Extension>
>next : Next

declare function compose<A, Args extends any[], Result>(first: (value: A) => Result, second: (...args: Args) => A): (...args: Args) => Result;
>compose : { <A, Args extends any[], Result>(first: (value: A) => Result, second: (...args: Args) => A): (...args: Args) => Result; <Result_1>(...functions: Function[]): (...args: any[]) => Result_1; }
>first : (value: A) => Result
>value : A
>second : (...args: Args) => A
>args : Args
>args : Args

declare function compose<Result>(...functions: Function[]): (...args: any[]) => Result;
>compose : { <A, Args extends any[], Result_1>(first: (value: A) => Result_1, second: (...args: Args) => A): (...args: Args) => Result_1; <Result>(...functions: Function[]): (...args: any[]) => Result; }
>functions : Function[]
>args : any[]

declare const instrument: Enhancer<{ extra: unknown }>, persist: Enhancer;
>instrument : Enhancer<{ extra: unknown; }>
>extra : unknown
>persist : Enhancer<{}>

const enhancer: Enhancer = compose(instrument, persist);
>enhancer : Enhancer<{}>
>compose(instrument, persist) : (...args: any[]) => Next
>compose : { <A, Args extends any[], Result>(first: (value: A) => Result, second: (...args: Args) => A): (...args: Args) => Result; <Result>(...functions: Function[]): (...args: any[]) => Result; }
>instrument : Enhancer<{ extra: unknown; }>
>persist : Enhancer<{}>

