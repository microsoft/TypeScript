>function* ({ n }) { return { p: n > 0 }; } : ({ n }: { n: number; }) => Generator<never, { p: boolean; }, any>
>n : number
>{ p: n > 0 } : { p: boolean; }
>p : boolean
>n > 0 : boolean
>n : number
>0 : 0

const check2: never = r2;
>check2 : never
>r2 : never

const r3 = s.toLayer(succeed(fn(function* ({ n }) {
>r3 : Request
>s.toLayer(succeed(fn(function* ({ n }) {  yield* request;  return { p: n > 0 };}))) : Request
>s.toLayer : <Req>(build: Eff<(p: { n: number; }) => Eff<{ p: boolean; }, Req>, never>) => Req
