>succeed(fn(function* ({ n }) {  yield* request;  return { p: n > 0 };})) : Eff<(args_0: { n: number; }) => Eff<{ p: boolean; }, Request>, never>
>succeed : <A>(a: A) => Eff<A, never>
>fn(function* ({ n }) {  yield* request;  return { p: n > 0 };}) : (args_0: { n: number; }) => Eff<{ p: boolean; }, Request>
>fn : <E extends Eff<any, any>, A, Args extends any[]>(body: (...args: Args) => Generator<E, A, any>) => (...args: Args) => Eff<A, ReqOf<E>>
>function* ({ n }) {  yield* request;  return { p: n > 0 };} : ({ n }: { n: number; }) => Generator<Eff<Request, Request>, { p: boolean; }, any>
>n : number

  yield* request;
>yield* request : Request
>request : Eff<Request, Request>

  return { p: n > 0 };
>{ p: n > 0 } : { p: boolean; }
>p : boolean
>n > 0 : boolean
>n : number
>0 : 0

})));
const check3: Request = r3;
>check3 : Request
>r3 : Request

// Shape 3: a generic alias as a parameter type, with the inference descending
// through nested arrays of a type computed by a recursive conditional type
// (cut down from Prisma's nested `select` results). The same type written
// inline still infers on every version.
type Payload = { scalars: object; objects: object };
>Payload : Payload
>scalars : object
>objects : object

type FindResult<P extends Payload, A> = A extends { select: infer S extends object }
>FindResult : FindResult<P, A>
>select : S

  ? {
      [K in keyof S]: S[K] extends object
        ? P extends { objects: { [k in K]: (infer O)[] } }
>objects : { [k in K]: O[]; }

          ? FindResult<O & Payload, S[K]>[]
          : never
        : P['scalars'][K & keyof P['scalars']];
    }
  : never;

type MessagePayload = { objects: {}; scalars: { body: string } };
>MessagePayload : MessagePayload
>objects : {}
>scalars : { body: string; }
>body : string

type ConversationPayload = { objects: { messages: MessagePayload[] }; scalars: {} };
>ConversationPayload : ConversationPayload
>objects : { messages: MessagePayload[]; }
>messages : MessagePayload[]
>scalars : {}

type ThreadPayload = { objects: { conversations: ConversationPayload[] }; scalars: {} };
>ThreadPayload : ThreadPayload
>objects : { conversations: ConversationPayload[]; }
>conversations : ConversationPayload[]
>scalars : {}

declare function findThread<A>(args: A): FindResult<ThreadPayload, A>;
>findThread : <A>(args: A) => FindResult<ThreadPayload, A>
>args : A

const thread = findThread({
>thread : { conversations: { messages: { body: string; }[]; }[]; }
>findThread({  select: { conversations: { select: { messages: { select: { body: true } } } } },}) : { conversations: { messages: { body: string; }[]; }[]; }
>findThread : <A>(args: A) => FindResult<ThreadPayload, A>
>{  select: { conversations: { select: { messages: { select: { body: true } } } } },} : { select: { conversations: { select: { messages: { select: { body: true; }; }; }; }; }; }

