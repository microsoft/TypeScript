//// [tests/cases/compiler/inferFromStringLiteralToKeyofOrder.ts] ////

=== inferFromStringLiteralToKeyofOrder.ts ===
// Inferring from a string literal or `string` to `keyof T` synthesizes an
// anonymous object type for `T` and interns it by the key type, so repeated
// inferences from the same key type produce the same type and union ordering
// proceeds to subsequent type arguments in every check order.

interface Pair<A, B> { a: A; b: B }
>Pair : Symbol(Pair, Decl(inferFromStringLiteralToKeyofOrder.ts, 0, 0))
>A : Symbol(A, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 15))
>B : Symbol(B, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 17))
>a : Symbol(Pair.a, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 22))
>A : Symbol(A, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 15))
>b : Symbol(Pair.b, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 28))
>B : Symbol(B, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 17))

declare function f<T, const U>(k: keyof T, u: U): Pair<T, U>;
>f : Symbol(f, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 35))
>T : Symbol(T, Decl(inferFromStringLiteralToKeyofOrder.ts, 6, 19))
>U : Symbol(U, Decl(inferFromStringLiteralToKeyofOrder.ts, 6, 21))
>k : Symbol(k, Decl(inferFromStringLiteralToKeyofOrder.ts, 6, 31))
>T : Symbol(T, Decl(inferFromStringLiteralToKeyofOrder.ts, 6, 19))
>u : Symbol(u, Decl(inferFromStringLiteralToKeyofOrder.ts, 6, 42))
>U : Symbol(U, Decl(inferFromStringLiteralToKeyofOrder.ts, 6, 21))
>Pair : Symbol(Pair, Decl(inferFromStringLiteralToKeyofOrder.ts, 0, 0))
>T : Symbol(T, Decl(inferFromStringLiteralToKeyofOrder.ts, 6, 19))
>U : Symbol(U, Decl(inferFromStringLiteralToKeyofOrder.ts, 6, 21))

declare const cond: boolean;
>cond : Symbol(cond, Decl(inferFromStringLiteralToKeyofOrder.ts, 7, 13))

const x = f("a", 1);
>x : Symbol(x, Decl(inferFromStringLiteralToKeyofOrder.ts, 9, 5))
>f : Symbol(f, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 35))

const y = f("a", 2);
>y : Symbol(y, Decl(inferFromStringLiteralToKeyofOrder.ts, 10, 5))
>f : Symbol(f, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 35))

const z = cond ? x : y;
>z : Symbol(z, Decl(inferFromStringLiteralToKeyofOrder.ts, 11, 5))
>cond : Symbol(cond, Decl(inferFromStringLiteralToKeyofOrder.ts, 7, 13))
>x : Symbol(x, Decl(inferFromStringLiteralToKeyofOrder.ts, 9, 5))
>y : Symbol(y, Decl(inferFromStringLiteralToKeyofOrder.ts, 10, 5))

const u = f("" as string, 1);
>u : Symbol(u, Decl(inferFromStringLiteralToKeyofOrder.ts, 13, 5))
>f : Symbol(f, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 35))

const v = f("" as string, 2);
>v : Symbol(v, Decl(inferFromStringLiteralToKeyofOrder.ts, 14, 5))
>f : Symbol(f, Decl(inferFromStringLiteralToKeyofOrder.ts, 5, 35))

const w = cond ? u : v;
>w : Symbol(w, Decl(inferFromStringLiteralToKeyofOrder.ts, 15, 5))
>cond : Symbol(cond, Decl(inferFromStringLiteralToKeyofOrder.ts, 7, 13))
>u : Symbol(u, Decl(inferFromStringLiteralToKeyofOrder.ts, 13, 5))
>v : Symbol(v, Decl(inferFromStringLiteralToKeyofOrder.ts, 14, 5))

