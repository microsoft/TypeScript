function getAllValuesSorted(m: ReadonlyArray<ReadonlyArray<string>>): ReadonlyArray<string> {
>getAllValuesSorted : (m: ReadonlyArray<ReadonlyArray<string>>) => ReadonlyArray<string>
>m : readonly (readonly string[])[]

