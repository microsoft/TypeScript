//// [tests/cases/compiler/inheritTypeAliasPoC.ts] ////

=== inheritTypeAliasPoC.ts ===
// Proof-of-concept test suite for the `inherit` type alias (issue #36165).
//
// `inherit` is a global type alias (defined in lib.es5.d.ts) that, when used with no explicit
// type arguments, is resolved contextually by the checker to the matching member type of the
// enclosing class's base class and/or implemented interfaces:
//
//   - Instance field          -> Base[Field]
//   - Method parameter         -> Parameters<Base[Field]>[Index]
//   - Method rest parameter    -> trailing tuple after `Index` leading params
//   - Method return value      -> ReturnType<Base[Field]>
//
// where Base is the intersection of the extends type and all implemented interfaces.
//
// This file is both a demonstration and an executable spec. Cases marked "SHOULD RESOLVE" are the
// intended behavior; cases marked "SHOULD ERROR" document intentional constraints. Where the
// current PoC does not yet match the intended behavior (notably `inherit` nested inside a composed
// type such as `Readonly<inherit>` or `inherit | "x"`), the baseline will reveal the gap.

interface Base {
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))

    field: "square" | "circle";
>field : Symbol(Base.field, Decl(inheritTypeAliasPoC.ts, 18, 16))

    foo(a: number, b: string): boolean;
>foo : Symbol(Base.foo, Decl(inheritTypeAliasPoC.ts, 19, 31))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 20, 8))
>b : Symbol(b, Decl(inheritTypeAliasPoC.ts, 20, 18))

    bar(a: number, b: string, c?: any): boolean;
>bar : Symbol(Base.bar, Decl(inheritTypeAliasPoC.ts, 20, 39))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 21, 8))
>b : Symbol(b, Decl(inheritTypeAliasPoC.ts, 21, 18))
>c : Symbol(c, Decl(inheritTypeAliasPoC.ts, 21, 29))
}

// ---------------------------------------------------------------------------
// 1. Baseline: every supported position, implements an interface.
// ---------------------------------------------------------------------------
class AllPositions implements Base {
>AllPositions : Symbol(AllPositions, Decl(inheritTypeAliasPoC.ts, 22, 1))
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))

    field: inherit = "square";                               // SHOULD RESOLVE: "square" | "circle"
>field : Symbol(AllPositions.field, Decl(inheritTypeAliasPoC.ts, 27, 36))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    foo(a: inherit, b: inherit): inherit {                   // SHOULD RESOLVE: a:number, b:string, ret:boolean
>foo : Symbol(AllPositions.foo, Decl(inheritTypeAliasPoC.ts, 28, 30))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 29, 8))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>b : Symbol(b, Decl(inheritTypeAliasPoC.ts, 29, 19))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

        return true;
    }
    bar(a: inherit, ...rest: inherit): inherit {             // SHOULD RESOLVE: a:number, rest:[string, any?], ret:boolean
>bar : Symbol(AllPositions.bar, Decl(inheritTypeAliasPoC.ts, 31, 5))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 32, 8))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>rest : Symbol(rest, Decl(inheritTypeAliasPoC.ts, 32, 19))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

        return true;
    }
}

// ---------------------------------------------------------------------------
// 2. Equivalence with the explicit (generic) form that compiles today.
// ---------------------------------------------------------------------------
class ExplicitForm implements Base {
>ExplicitForm : Symbol(ExplicitForm, Decl(inheritTypeAliasPoC.ts, 35, 1))
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))

    field: inherit<Base, "field"> = "circle";
>field : Symbol(ExplicitForm.field, Decl(inheritTypeAliasPoC.ts, 40, 36))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))

    foo(a: inherit<Base, "foo", "Param", 0>, b: inherit<Base, "foo", "Param", 1>): inherit<Base, "foo", "Return"> {
>foo : Symbol(ExplicitForm.foo, Decl(inheritTypeAliasPoC.ts, 41, 45))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 42, 8))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))
>b : Symbol(b, Decl(inheritTypeAliasPoC.ts, 42, 44))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))

        return true;
    }
    bar(a: inherit<Base, "bar", "Param", 0>, ...rest: inherit<Base, "bar", "Rest", 1>): inherit<Base, "bar", "Return"> {
>bar : Symbol(ExplicitForm.bar, Decl(inheritTypeAliasPoC.ts, 44, 5))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 45, 8))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))
>rest : Symbol(rest, Decl(inheritTypeAliasPoC.ts, 45, 44))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>Base : Symbol(Base, Decl(inheritTypeAliasPoC.ts, 0, 0))

        return true;
    }
}

// ---------------------------------------------------------------------------
// 3. extends-only (class base, no interfaces).
// ---------------------------------------------------------------------------
class Geometry {
>Geometry : Symbol(Geometry, Decl(inheritTypeAliasPoC.ts, 48, 1))

    model: "square" | "circle" = "square";
>model : Symbol(Geometry.model, Decl(inheritTypeAliasPoC.ts, 53, 16))

    render(scale: number): void {}
>render : Symbol(Geometry.render, Decl(inheritTypeAliasPoC.ts, 54, 42))
>scale : Symbol(scale, Decl(inheritTypeAliasPoC.ts, 55, 11))
}
class Canvas extends Geometry {
>Canvas : Symbol(Canvas, Decl(inheritTypeAliasPoC.ts, 56, 1))
>Geometry : Symbol(Geometry, Decl(inheritTypeAliasPoC.ts, 48, 1))

    model: inherit = "square";                               // SHOULD RESOLVE: "square" | "circle"
>model : Symbol(Canvas.model, Decl(inheritTypeAliasPoC.ts, 57, 31))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    render(scale: inherit): inherit {}                       // SHOULD RESOLVE: scale:number, ret:void
>render : Symbol(Canvas.render, Decl(inheritTypeAliasPoC.ts, 58, 30))
>scale : Symbol(scale, Decl(inheritTypeAliasPoC.ts, 59, 11))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
}

// ---------------------------------------------------------------------------
// 4. Multiple bases: extends + implements, intersected as (Base & A & B).
// ---------------------------------------------------------------------------
interface A { a: number; shared: string; }
>A : Symbol(A, Decl(inheritTypeAliasPoC.ts, 60, 1))
>a : Symbol(A.a, Decl(inheritTypeAliasPoC.ts, 65, 13))
>shared : Symbol(A.shared, Decl(inheritTypeAliasPoC.ts, 65, 24))

interface B { b: "x" | "y"; shared: string; }
>B : Symbol(B, Decl(inheritTypeAliasPoC.ts, 65, 42))
>b : Symbol(B.b, Decl(inheritTypeAliasPoC.ts, 66, 13))
>shared : Symbol(B.shared, Decl(inheritTypeAliasPoC.ts, 66, 27))

class BaseC { c: boolean = true; }
>BaseC : Symbol(BaseC, Decl(inheritTypeAliasPoC.ts, 66, 45))
>c : Symbol(BaseC.c, Decl(inheritTypeAliasPoC.ts, 67, 13))

class Multi extends BaseC implements A, B {
>Multi : Symbol(Multi, Decl(inheritTypeAliasPoC.ts, 67, 34))
>BaseC : Symbol(BaseC, Decl(inheritTypeAliasPoC.ts, 66, 45))
>A : Symbol(A, Decl(inheritTypeAliasPoC.ts, 60, 1))
>B : Symbol(B, Decl(inheritTypeAliasPoC.ts, 65, 42))

    a: inherit = 1;                                          // SHOULD RESOLVE: number
>a : Symbol(Multi.a, Decl(inheritTypeAliasPoC.ts, 68, 43))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    b: inherit = "x";                                        // SHOULD RESOLVE: "x" | "y"
>b : Symbol(Multi.b, Decl(inheritTypeAliasPoC.ts, 69, 19))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    c: inherit = false;                                      // SHOULD RESOLVE: boolean (from extends)
>c : Symbol(Multi.c, Decl(inheritTypeAliasPoC.ts, 70, 21))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    shared: inherit = "s";                                   // SHOULD RESOLVE: string (A & B agree)
>shared : Symbol(Multi.shared, Decl(inheritTypeAliasPoC.ts, 71, 23))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
}

// ---------------------------------------------------------------------------
// 4b. Conflicting member types across interfaces narrow to their intersection.
//     Foo.shape = "square" | "circle", Bar.shape = "circle" | "triangle"
//     => (Foo & Bar)["shape"] = "circle"
// ---------------------------------------------------------------------------
interface Foo { shape: "square" | "circle"; }
>Foo : Symbol(Foo, Decl(inheritTypeAliasPoC.ts, 73, 1))
>shape : Symbol(Foo.shape, Decl(inheritTypeAliasPoC.ts, 80, 15))

interface Bar { shape: "circle" | "triangle"; }
>Bar : Symbol(Bar, Decl(inheritTypeAliasPoC.ts, 80, 45))
>shape : Symbol(Bar.shape, Decl(inheritTypeAliasPoC.ts, 81, 15))

class IntersectNarrow implements Foo, Bar {
>IntersectNarrow : Symbol(IntersectNarrow, Decl(inheritTypeAliasPoC.ts, 81, 47))
>Foo : Symbol(Foo, Decl(inheritTypeAliasPoC.ts, 73, 1))
>Bar : Symbol(Bar, Decl(inheritTypeAliasPoC.ts, 80, 45))

    shape: inherit = "circle";                               // SHOULD RESOLVE: "circle" (only common member)
>shape : Symbol(IntersectNarrow.shape, Decl(inheritTypeAliasPoC.ts, 82, 43))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
}
class IntersectNarrowBad implements Foo, Bar {
>IntersectNarrowBad : Symbol(IntersectNarrowBad, Decl(inheritTypeAliasPoC.ts, 84, 1))
>Foo : Symbol(Foo, Decl(inheritTypeAliasPoC.ts, 73, 1))
>Bar : Symbol(Bar, Decl(inheritTypeAliasPoC.ts, 80, 45))

    shape: inherit = "square";                               // SHOULD ERROR: "square" not in the intersection "circle"
>shape : Symbol(IntersectNarrowBad.shape, Decl(inheritTypeAliasPoC.ts, 85, 46))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
}

// ---------------------------------------------------------------------------
// 5. Composition: inherit nested inside other type constructors.
// ---------------------------------------------------------------------------
interface Robot {
>Robot : Symbol(Robot, Decl(inheritTypeAliasPoC.ts, 87, 1))

    sensors: {sight?: boolean, hearing?: boolean, touch?: boolean};
>sensors : Symbol(Robot.sensors, Decl(inheritTypeAliasPoC.ts, 92, 17))
>sight : Symbol(sight, Decl(inheritTypeAliasPoC.ts, 93, 14))
>hearing : Symbol(hearing, Decl(inheritTypeAliasPoC.ts, 93, 30))
>touch : Symbol(touch, Decl(inheritTypeAliasPoC.ts, 93, 49))

    doAction(action: "walk" | "turn"): void;
>doAction : Symbol(Robot.doAction, Decl(inheritTypeAliasPoC.ts, 93, 67))
>action : Symbol(action, Decl(inheritTypeAliasPoC.ts, 94, 13))
}
class FlyingRobot implements Robot {
>FlyingRobot : Symbol(FlyingRobot, Decl(inheritTypeAliasPoC.ts, 95, 1))
>Robot : Symbol(Robot, Decl(inheritTypeAliasPoC.ts, 87, 1))

    sensors: Required<inherit> = {sight: true, hearing: false, touch: false};  // SHOULD RESOLVE: {sight: boolean, hearing: boolean, touch: boolean};
>sensors : Symbol(FlyingRobot.sensors, Decl(inheritTypeAliasPoC.ts, 96, 36))
>Required : Symbol(Required, Decl(lib.es5.d.ts, --, --))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>sight : Symbol(sight, Decl(inheritTypeAliasPoC.ts, 97, 34))
>hearing : Symbol(hearing, Decl(inheritTypeAliasPoC.ts, 97, 46))
>touch : Symbol(touch, Decl(inheritTypeAliasPoC.ts, 97, 62))

    doAction(action: inherit | "fly"): inherit {             // SHOULD RESOLVE: action:"walk"|"turn"|"fly"
>doAction : Symbol(FlyingRobot.doAction, Decl(inheritTypeAliasPoC.ts, 97, 77))
>action : Symbol(action, Decl(inheritTypeAliasPoC.ts, 98, 13))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
    }
}

// ---------------------------------------------------------------------------
// 6. Arrow-function field: field-level inherit, params inferred by assignment.
// ---------------------------------------------------------------------------
