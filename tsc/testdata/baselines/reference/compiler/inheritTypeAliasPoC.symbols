}

// ---------------------------------------------------------------------------
// 2. Multiple bases: extends + implements, intersected as (Base & A & B).
// ---------------------------------------------------------------------------
interface A { a: number; shared: string; }
>A : Symbol(A, Decl(inheritTypeAliasPoC.ts, 49, 1))
>a : Symbol(A.a, Decl(inheritTypeAliasPoC.ts, 54, 13))
>shared : Symbol(A.shared, Decl(inheritTypeAliasPoC.ts, 54, 24))

interface B { b: "x" | "y"; shared: string; }
>B : Symbol(B, Decl(inheritTypeAliasPoC.ts, 54, 42))
>b : Symbol(B.b, Decl(inheritTypeAliasPoC.ts, 55, 13))
>shared : Symbol(B.shared, Decl(inheritTypeAliasPoC.ts, 55, 27))

class BaseC { c: boolean = true; }
>BaseC : Symbol(BaseC, Decl(inheritTypeAliasPoC.ts, 55, 45))
>c : Symbol(BaseC.c, Decl(inheritTypeAliasPoC.ts, 56, 13))

class Multi extends BaseC implements A, B {
>Multi : Symbol(Multi, Decl(inheritTypeAliasPoC.ts, 56, 34))
>BaseC : Symbol(BaseC, Decl(inheritTypeAliasPoC.ts, 55, 45))
>A : Symbol(A, Decl(inheritTypeAliasPoC.ts, 49, 1))
>B : Symbol(B, Decl(inheritTypeAliasPoC.ts, 54, 42))

    a: inherit = 1;                                          // SHOULD RESOLVE: number
>a : Symbol(Multi.a, Decl(inheritTypeAliasPoC.ts, 57, 43))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    b: inherit = "x";                                        // SHOULD RESOLVE: "x" | "y"
>b : Symbol(Multi.b, Decl(inheritTypeAliasPoC.ts, 58, 19))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    c: inherit = false;                                      // SHOULD RESOLVE: boolean (from extends)
>c : Symbol(Multi.c, Decl(inheritTypeAliasPoC.ts, 59, 21))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    shared: inherit = "s";                                   // SHOULD RESOLVE: string (A & B agree)
>shared : Symbol(Multi.shared, Decl(inheritTypeAliasPoC.ts, 60, 23))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
}

// ---------------------------------------------------------------------------
// 3. Conflicting member types across interfaces narrow to their intersection.
//     Foo.shape = "square" | "circle", Bar.shape = "circle" | "triangle"
//     => (Foo & Bar)["shape"] = "circle"
// ---------------------------------------------------------------------------
interface Foo { shape: "square" | "circle"; }
>Foo : Symbol(Foo, Decl(inheritTypeAliasPoC.ts, 62, 1))
>shape : Symbol(Foo.shape, Decl(inheritTypeAliasPoC.ts, 69, 15))

interface Bar { shape: "circle" | "triangle"; }
>Bar : Symbol(Bar, Decl(inheritTypeAliasPoC.ts, 69, 45))
>shape : Symbol(Bar.shape, Decl(inheritTypeAliasPoC.ts, 70, 15))

class IntersectNarrow implements Foo, Bar {
>IntersectNarrow : Symbol(IntersectNarrow, Decl(inheritTypeAliasPoC.ts, 70, 47))
>Foo : Symbol(Foo, Decl(inheritTypeAliasPoC.ts, 62, 1))
>Bar : Symbol(Bar, Decl(inheritTypeAliasPoC.ts, 69, 45))

    shape: inherit = "circle";                               // SHOULD RESOLVE: "circle" (only common member)
>shape : Symbol(IntersectNarrow.shape, Decl(inheritTypeAliasPoC.ts, 71, 43))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
}
class IntersectNarrowBad implements Foo, Bar {
>IntersectNarrowBad : Symbol(IntersectNarrowBad, Decl(inheritTypeAliasPoC.ts, 73, 1))
>Foo : Symbol(Foo, Decl(inheritTypeAliasPoC.ts, 62, 1))
>Bar : Symbol(Bar, Decl(inheritTypeAliasPoC.ts, 69, 45))

    shape: inherit = "square";                               // SHOULD ERROR: "square" not in the intersection "circle"
>shape : Symbol(IntersectNarrowBad.shape, Decl(inheritTypeAliasPoC.ts, 74, 46))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
}

// ---------------------------------------------------------------------------
// 4. Composition: inherit nested inside other type constructors.
// ---------------------------------------------------------------------------
interface Robot {
>Robot : Symbol(Robot, Decl(inheritTypeAliasPoC.ts, 76, 1))

    sensors: {sight?: boolean, hearing?: boolean, touch?: boolean};
>sensors : Symbol(Robot.sensors, Decl(inheritTypeAliasPoC.ts, 81, 17))
>sight : Symbol(sight, Decl(inheritTypeAliasPoC.ts, 82, 14))
>hearing : Symbol(hearing, Decl(inheritTypeAliasPoC.ts, 82, 30))
>touch : Symbol(touch, Decl(inheritTypeAliasPoC.ts, 82, 49))

    doAction(action: "walk" | "turn"): void;
>doAction : Symbol(Robot.doAction, Decl(inheritTypeAliasPoC.ts, 82, 67))
>action : Symbol(action, Decl(inheritTypeAliasPoC.ts, 83, 13))
}
class FlyingRobot implements Robot {
>FlyingRobot : Symbol(FlyingRobot, Decl(inheritTypeAliasPoC.ts, 84, 1))
>Robot : Symbol(Robot, Decl(inheritTypeAliasPoC.ts, 76, 1))

    sensors: Required<inherit> = {sight: true, hearing: false, touch: false};  // SHOULD RESOLVE: {sight: boolean, hearing: boolean, touch: boolean};
>sensors : Symbol(FlyingRobot.sensors, Decl(inheritTypeAliasPoC.ts, 85, 36))
>Required : Symbol(Required, Decl(lib.es5.d.ts, --, --))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>sight : Symbol(sight, Decl(inheritTypeAliasPoC.ts, 86, 34))
>hearing : Symbol(hearing, Decl(inheritTypeAliasPoC.ts, 86, 46))
>touch : Symbol(touch, Decl(inheritTypeAliasPoC.ts, 86, 62))

    doAction(action: inherit | "fly"): inherit {             // SHOULD RESOLVE: action:"walk"|"turn"|"fly"
>doAction : Symbol(FlyingRobot.doAction, Decl(inheritTypeAliasPoC.ts, 86, 77))
>action : Symbol(action, Decl(inheritTypeAliasPoC.ts, 87, 13))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
    }
}

// ---------------------------------------------------------------------------
// 5. Arrow-function field: field-level inherit, params inferred by assignment.
// ---------------------------------------------------------------------------
