>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    foo: inherit = (a, b) => true;                           // SHOULD RESOLVE: foo:(a:number,b:string)=>boolean
>foo : Symbol(ArrowField.foo, Decl(inheritTypeAliasPoC.ts, 106, 30))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 107, 20))
>b : Symbol(b, Decl(inheritTypeAliasPoC.ts, 107, 22))

    bar: inherit = (a, b, c) => true;
>bar : Symbol(ArrowField.bar, Decl(inheritTypeAliasPoC.ts, 107, 34))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 108, 20))
>b : Symbol(b, Decl(inheritTypeAliasPoC.ts, 108, 22))
>c : Symbol(c, Decl(inheritTypeAliasPoC.ts, 108, 25))
}

