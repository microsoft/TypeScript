>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

    foo: inherit = (a, b) => true;                           // SHOULD RESOLVE: foo:(a:number,b:string)=>boolean
>foo : Symbol(ArrowField.foo, Decl(inheritTypeAliasPoC.ts, 95, 30))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 96, 20))
>b : Symbol(b, Decl(inheritTypeAliasPoC.ts, 96, 22))

    bar: inherit = (a, b, c) => true;
>bar : Symbol(ArrowField.bar, Decl(inheritTypeAliasPoC.ts, 96, 34))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>a : Symbol(a, Decl(inheritTypeAliasPoC.ts, 97, 20))
>b : Symbol(b, Decl(inheritTypeAliasPoC.ts, 97, 22))
>c : Symbol(c, Decl(inheritTypeAliasPoC.ts, 97, 25))
}

// ---------------------------------------------------------------------------
// 6. Accessors: a getter's return and a setter's parameter inherit the FIELD type.
//     (Issue lists "Getter return value" and "Setter parameter" as supported positions.)
// ---------------------------------------------------------------------------
abstract class ShapeBase {
>ShapeBase : Symbol(ShapeBase, Decl(inheritTypeAliasPoC.ts, 98, 1))

    abstract kind: "square" | "circle";
>kind : Symbol(ShapeBase.kind, Decl(inheritTypeAliasPoC.ts, 104, 26))
}
class ShapeImpl extends ShapeBase {
>ShapeImpl : Symbol(ShapeImpl, Decl(inheritTypeAliasPoC.ts, 106, 1))
>ShapeBase : Symbol(ShapeBase, Decl(inheritTypeAliasPoC.ts, 98, 1))

    private _kind: "square" | "circle" = "square";
>_kind : Symbol(ShapeImpl._kind, Decl(inheritTypeAliasPoC.ts, 107, 35))

    get kind(): inherit {                                    // SHOULD RESOLVE: "square" | "circle" (field type)
>kind : Symbol(ShapeImpl.kind, Decl(inheritTypeAliasPoC.ts, 108, 50), Decl(inheritTypeAliasPoC.ts, 111, 5))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

        return this._kind;
>this._kind : Symbol(ShapeImpl._kind, Decl(inheritTypeAliasPoC.ts, 107, 35))
>this : Symbol(ShapeImpl, Decl(inheritTypeAliasPoC.ts, 106, 1))
>_kind : Symbol(ShapeImpl._kind, Decl(inheritTypeAliasPoC.ts, 107, 35))
    }
    set kind(v: inherit) {                                   // SHOULD RESOLVE: "square" | "circle" (field type)
>kind : Symbol(ShapeImpl.kind, Decl(inheritTypeAliasPoC.ts, 108, 50), Decl(inheritTypeAliasPoC.ts, 111, 5))
>v : Symbol(v, Decl(inheritTypeAliasPoC.ts, 112, 13))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

        this._kind = v;
>this._kind : Symbol(ShapeImpl._kind, Decl(inheritTypeAliasPoC.ts, 107, 35))
>this : Symbol(ShapeImpl, Decl(inheritTypeAliasPoC.ts, 106, 1))
>_kind : Symbol(ShapeImpl._kind, Decl(inheritTypeAliasPoC.ts, 107, 35))
>v : Symbol(v, Decl(inheritTypeAliasPoC.ts, 112, 13))
    }
}
class ShapeImplBadGetter extends ShapeBase {
>ShapeImplBadGetter : Symbol(ShapeImplBadGetter, Decl(inheritTypeAliasPoC.ts, 115, 1))
>ShapeBase : Symbol(ShapeBase, Decl(inheritTypeAliasPoC.ts, 98, 1))

    get kind(): inherit {
>kind : Symbol(ShapeImplBadGetter.kind, Decl(inheritTypeAliasPoC.ts, 116, 44), Decl(inheritTypeAliasPoC.ts, 119, 5))
>inherit : Symbol(inherit, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))

