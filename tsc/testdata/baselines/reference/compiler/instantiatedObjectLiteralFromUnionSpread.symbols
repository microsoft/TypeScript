//// [tests/cases/compiler/instantiatedObjectLiteralFromUnionSpread.ts] ////

=== instantiatedObjectLiteralFromUnionSpread.ts ===
// A spread of a union of two object types in a generic function makes two
// object literal types that share the symbol of the spread expression. Each
// call of the function instantiates both of them with the same type
// arguments, so the return type of the call is a union of two instantiations
// with equal mappers.
//
// readParts also returns the constituent with `b: number`, narrowed from that
// union. Reading `all` first instantiates the two object literal types in
// union order; reading `withNumber` first instantiates the second of them
// before the first. The unions of `allX` and `allY` list their members in the
// same order.

declare const ctx: { a: string; b: undefined } | { a: string; b: number };
>ctx : Symbol(ctx, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 13))
>a : Symbol(a, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 20))
>b : Symbol(b, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 31))
>a : Symbol(a, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 50))
>b : Symbol(b, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 61))

function read<K extends string>(fields: readonly K[]) {
>read : Symbol(read, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 74))
>K : Symbol(K, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 14, 14))
>fields : Symbol(fields, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 14, 32))
>K : Symbol(K, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 14, 14))

    return { ...ctx, projection: fields };
>ctx : Symbol(ctx, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 13))
>projection : Symbol(projection, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 15, 20))
>fields : Symbol(fields, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 14, 32))
}

export const r = read(["x"]);
>r : Symbol(r, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 18, 12))
>read : Symbol(read, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 74))

function readParts<K extends string>(fields: readonly K[]) {
>readParts : Symbol(readParts, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 18, 29))
>K : Symbol(K, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 20, 19))
>fields : Symbol(fields, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 20, 37))
>K : Symbol(K, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 20, 19))

    const v = { ...ctx, projection: fields };
>v : Symbol(v, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 21, 9))
>ctx : Symbol(ctx, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 13))
>projection : Symbol(projection, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 21, 23))
>fields : Symbol(fields, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 20, 37))

    return { all: v, withNumber: v.b !== undefined ? v : undefined };
>all : Symbol(all, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 22, 12))
>v : Symbol(v, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 21, 9))
>withNumber : Symbol(withNumber, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 22, 20))
>v.b : Symbol(b, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 31), Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 61))
>v : Symbol(v, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 21, 9))
>b : Symbol(b, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 31), Decl(instantiatedObjectLiteralFromUnionSpread.ts, 12, 61))
>undefined : Symbol(undefined)
>v : Symbol(v, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 21, 9))
>undefined : Symbol(undefined)
}

const x = readParts(["x"]);
>x : Symbol(x, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 25, 5))
>readParts : Symbol(readParts, Decl(instantiatedObjectLiteralFromUnionSpread.ts, 18, 29))

