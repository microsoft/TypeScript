>r : { a: string; b: undefined; projection: readonly "x"[]; } | { a: string; b: number; projection: readonly "x"[]; }
>read(["x"]) : { a: string; b: undefined; projection: readonly "x"[]; } | { a: string; b: number; projection: readonly "x"[]; }
>read : <K extends string>(fields: readonly K[]) => { a: string; b: undefined; projection: readonly K[]; } | { a: string; b: number; projection: readonly K[]; }
>["x"] : "x"[]
>"x" : "x"

function readParts<K extends string>(fields: readonly K[]) {
>readParts : <K extends string>(fields: readonly K[]) => { all: { a: string; b: undefined; projection: readonly K[]; } | { a: string; b: number; projection: readonly K[]; }; withNumber: { a: string; b: number; projection: readonly K[]; } | undefined; }
>fields : readonly K[]

    const v = { ...ctx, projection: fields };
>v : { a: string; b: undefined; projection: readonly K[]; } | { a: string; b: number; projection: readonly K[]; }
>{ ...ctx, projection: fields } : { a: string; b: undefined; projection: readonly K[]; } | { a: string; b: number; projection: readonly K[]; }
>ctx : { a: string; b: undefined; } | { a: string; b: number; }
>projection : readonly K[]
>fields : readonly K[]

    return { all: v, withNumber: v.b !== undefined ? v : undefined };
>{ all: v, withNumber: v.b !== undefined ? v : undefined } : { all: { a: string; b: undefined; projection: readonly K[]; } | { a: string; b: number; projection: readonly K[]; }; withNumber: { a: string; b: number; projection: readonly K[]; } | undefined; }
>all : { a: string; b: undefined; projection: readonly K[]; } | { a: string; b: number; projection: readonly K[]; }
>v : { a: string; b: undefined; projection: readonly K[]; } | { a: string; b: number; projection: readonly K[]; }
>withNumber : { a: string; b: number; projection: readonly K[]; } | undefined
>v.b !== undefined ? v : undefined : { a: string; b: number; projection: readonly K[]; } | undefined
>v.b !== undefined : boolean
>v.b : number | undefined
>v : { a: string; b: undefined; projection: readonly K[]; } | { a: string; b: number; projection: readonly K[]; }
>b : number | undefined
>undefined : undefined
>v : { a: string; b: number; projection: readonly K[]; }
