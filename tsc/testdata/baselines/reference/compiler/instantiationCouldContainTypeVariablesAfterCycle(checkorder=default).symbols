//// [tests/cases/compiler/instantiationCouldContainTypeVariablesAfterCycle.ts] ////

=== instantiationCouldContainTypeVariablesAfterCycle.ts ===
// Query<any> is instantiated with only non-generic arguments, so it (and DeepPartial<Query<any>>)
// can't contain type variables, and inference from Meta<any> must not structurally recurse into
// DeepPartial<Query<any>>. That recursion would expand the infinite DeepPartial<Nested> and report
// TS5114. The carry-forward of the "could contain type variables" flag set at instantiation time
// must survive even when the instantiation is created inside a circularity that is later discarded.

declare const a: Meta<any>;
>a : Symbol(a, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 6, 13))
>Meta : Symbol(Meta, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 10, 36))

fromMetadata(a);
>fromMetadata : Symbol(fromMetadata, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 16, 33))
>a : Symbol(a, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 6, 13))

type DeepPartial<T> = { [P in keyof T]: DeepPartial<T[P]> };
>DeepPartial : Symbol(DeepPartial, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 7, 16))
>T : Symbol(T, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 8, 17))
>P : Symbol(P, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 8, 25))
>T : Symbol(T, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 8, 17))
>DeepPartial : Symbol(DeepPartial, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 7, 16))
>T : Symbol(T, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 8, 17))
>P : Symbol(P, Decl(instantiationCouldContainTypeVariablesAfterCycle.ts, 8, 25))

