>I : Symbol(I, Decl(instantiationLimitsCheckOrder.ts, 13, 25))
>J : Symbol(J, Decl(instantiationLimitsCheckOrder.ts, 13, 62))
>K : Symbol(K, Decl(instantiationLimitsCheckOrder.ts, 4, 47))
>Wide2 : Symbol(Wide2, Decl(instantiationLimitsCheckOrder.ts, 9, 28))
>N : Symbol(N, Decl(instantiationLimitsCheckOrder.ts, 13, 11))
>J : Symbol(J, Decl(instantiationLimitsCheckOrder.ts, 13, 62))
>I : Symbol(I, Decl(instantiationLimitsCheckOrder.ts, 13, 25))
>K : Symbol(K, Decl(instantiationLimitsCheckOrder.ts, 4, 47))

type Wide2Tail = Wide2<[0, 0, 0, 0], "">;
>Wide2Tail : Symbol(Wide2Tail, Decl(instantiationLimitsCheckOrder.ts, 13, 104))
>Wide2 : Symbol(Wide2, Decl(instantiationLimitsCheckOrder.ts, 9, 28))

type Wide2All = Wide2<[], "">;
>Wide2All : Symbol(Wide2All, Decl(instantiationLimitsCheckOrder.ts, 14, 41))
>Wide2 : Symbol(Wide2, Decl(instantiationLimitsCheckOrder.ts, 9, 28))

// Over a hundred nested instantiations, half of which already happened for
// another statement.
type Deep<N extends 0[]> = N["length"] extends 60 ? never : Deep<[...N, 0]> | N["length"];
>Deep : Symbol(Deep, Decl(instantiationLimitsCheckOrder.ts, 15, 30))
