>I : Symbol(I, Decl(instantiationLimitsCheckOrder.ts, 8, 24))
>J : Symbol(J, Decl(instantiationLimitsCheckOrder.ts, 8, 61))
>K : Symbol(K, Decl(instantiationLimitsCheckOrder.ts, 4, 47))
>Wide : Symbol(Wide, Decl(instantiationLimitsCheckOrder.ts, 5, 24))
>N : Symbol(N, Decl(instantiationLimitsCheckOrder.ts, 8, 10))
>J : Symbol(J, Decl(instantiationLimitsCheckOrder.ts, 8, 61))
>I : Symbol(I, Decl(instantiationLimitsCheckOrder.ts, 8, 24))
>K : Symbol(K, Decl(instantiationLimitsCheckOrder.ts, 4, 47))

type WideAll = Wide<[], "">;
>WideAll : Symbol(WideAll, Decl(instantiationLimitsCheckOrder.ts, 8, 102))
>Wide : Symbol(Wide, Decl(instantiationLimitsCheckOrder.ts, 5, 24))

// The same, but half of the instantiations already happened for another
// statement.
type Wide2<N extends 0[], I> = N["length"] extends 8 ? I : { [J in K]: Wide2<[...N, 0], [J, I][0]> }[K];
>Wide2 : Symbol(Wide2, Decl(instantiationLimitsCheckOrder.ts, 9, 28))
>N : Symbol(N, Decl(instantiationLimitsCheckOrder.ts, 13, 11))
>I : Symbol(I, Decl(instantiationLimitsCheckOrder.ts, 13, 25))
