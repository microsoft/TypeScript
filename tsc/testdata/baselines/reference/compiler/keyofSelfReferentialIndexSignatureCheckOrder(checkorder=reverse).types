//// [tests/cases/compiler/keyofSelfReferentialIndexSignatureCheckOrder.ts] ////

=== keyofSelfReferentialIndexSignatureCheckOrder.ts ===
// The index signature of each type refers to its own keyof, so resolving its
// members needs its keyof, which needs its members. Checking an interface
// with several bases, or a type with a class base, reads its declared
// members while they are incomplete. Its keyof, and its index signature,
// must not depend on whether keyof is needed before or after the type is
// checked (65543).

interface A { a?: string; }
>a : string | undefined

interface B { b?: number; }
>b : number | undefined

class C { c?: string; }
>C : C
>c : string | undefined

const k0: keyof P0 = 0;
>k0 : keyof P0
>0 : 0

interface P0 { a?: string; [key: string]: P0[keyof P0]; }
>a : string | undefined
>key : string

interface Q0 { a?: string; [key: string]: Q0[keyof Q0]; }
>a : string | undefined
>key : string

const j0: keyof Q0 = 0;
>j0 : keyof Q0
>0 : 0

const k1: keyof P1 = 0;
>k1 : keyof P1
>0 : 0

interface P1 extends A { [key: string]: P1[keyof P1]; }
>key : string

interface Q1 extends A { [key: string]: Q1[keyof Q1]; }
>key : string

const j1: keyof Q1 = 0;
>j1 : keyof Q1
>0 : 0

const k2: keyof P2 = 0;
>k2 : keyof P2
>0 : 0

interface P2 extends A, B { [key: string]: P2[keyof P2]; }
>key : string

interface Q2 extends A, B { [key: string]: Q2[keyof Q2]; }
>key : string

const j2: keyof Q2 = 0;
>j2 : keyof Q2
>0 : 0

const k3: keyof P3 = 0;
>k3 : keyof P3
>0 : 0

interface P3 extends C { [key: string]: P3[keyof P3]; }
>key : string

interface Q3 extends C { [key: string]: Q3[keyof Q3]; }
>key : string

const j3: keyof Q3 = 0;
>j3 : "c"
>0 : 0

const k4: keyof P4 = 0;
>k4 : keyof P4
>0 : 0

class P4 extends C { b?: number; [key: string]: P4[keyof P4]; }
>P4 : P4
>C : C
>b : number | undefined
>key : string

class Q4 extends C { b?: number; [key: string]: Q4[keyof Q4]; }
>Q4 : Q4
>C : C
>b : number | undefined
>key : string

const j4: keyof Q4 = 0;
>j4 : keyof Q4
>0 : 0

declare const q2: Q2;
>q2 : Q2

const v2 = q2.other;
>v2 : any
>q2.other : any
>q2 : Q2
>other : any

declare const q3: Q3;
>q3 : Q3

const v3 = q3.other;
>v3 : any
>q3.other : any
>q3 : Q3
>other : any

