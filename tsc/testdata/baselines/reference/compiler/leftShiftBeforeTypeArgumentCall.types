//// [tests/cases/compiler/leftShiftBeforeTypeArgumentCall.ts] ////

=== leftShiftBeforeTypeArgumentCall.ts ===
// https://github.com/microsoft/TypeScript/issues/37760

function alignof<T>(): number { return 1; }
>alignof : <T>() => number
>1 : 1

function f1<T>(): number { return 1 << alignof<T[]>(); }
>f1 : <T>() => number
>1 << alignof<T[]>() : number
>1 : 1
>alignof<T[]>() : number
>alignof : <T_1>() => number

function f2<T>(): number { return 1 >> alignof<T[]>(); }
>f2 : <T>() => number
>1 >> alignof<T[]>() : number
>1 : 1
>alignof<T[]>() : number
>alignof : <T_1>() => number

function f3<T>(): number { return 1 >>> alignof<T[]>(); }
>f3 : <T>() => number
>1 >>> alignof<T[]>() : number
>1 : 1
>alignof<T[]>() : number
>alignof : <T_1>() => number

function f4<T>(): number { return 1 << (alignof<T[]>()); }
>f4 : <T>() => number
>1 << (alignof<T[]>()) : number
>1 : 1
>(alignof<T[]>()) : number
>alignof<T[]>() : number
>alignof : <T_1>() => number

function f5<T>(x: number): number { x <<= alignof<T[]>(); return x; }
>f5 : <T>(x: number) => number
>x : number
>x <<= alignof<T[]>() : number
>x : number
>alignof<T[]>() : number
>alignof : <T_1>() => number
>x : number

function f6<T>(x: number): number { x >>= alignof<T[]>(); return x; }
>f6 : <T>(x: number) => number
>x : number
>x >>= alignof<T[]>() : number
>x : number
>alignof<T[]>() : number
>alignof : <T_1>() => number
>x : number

function f7<T>(x: number): number { x >>>= alignof<T[]>(); return x; }
>f7 : <T>(x: number) => number
>x : number
>x >>>= alignof<T[]>() : number
>x : number
>alignof<T[]>() : number
>alignof : <T_1>() => number
>x : number

function f8<T>(): number { return 1 < alignof<T[]>() ? 1 : 0; }
>f8 : <T>() => number
>1 < alignof<T[]>() ? 1 : 0 : 0 | 1
>1 < alignof<T[]>() : boolean
>1 : 1
>alignof<T[]>() : number
>alignof : <T_1>() => number
>1 : 1
>0 : 0

function f9(): number { return 1 << alignof<string>(); }
>f9 : () => number
>1 << alignof<string>() : number
>1 : 1
>alignof<string>() : number
>alignof : <T>() => number

// `<<` that starts a type argument list with a generic function type is still a type argument list.
declare function g<F>(f: F): F;
>g : <F>(f: F) => F
>f : F

const h = g<<U>(x: U) => U>((x) => x);
>h : <U>(x: U) => U
>g<<U>(x: U) => U>((x) => x) : <U>(x: U) => U
>g : <F>(f: F) => F
>x : U
>(x) => x : <U>(x: U) => U
>x : U
>x : U

const n: number = h(1);
>n : number
>h(1) : 1
>h : <U>(x: U) => U
>1 : 1

