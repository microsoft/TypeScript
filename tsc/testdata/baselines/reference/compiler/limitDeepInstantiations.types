//// [tests/cases/compiler/limitDeepInstantiations.ts] ////

=== limitDeepInstantiations.ts ===
type BuildTuple<Length extends number, Elements extends unknown[] = []> =
>BuildTuple : BuildTuple<Length, Elements>

	Elements["length"] extends Length ? [] : [unknown, ...BuildTuple<Length, [unknown, ...Elements]>];

declare const shallow: BuildTuple<8>;
>shallow : [unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown]

const shallowLength: 8 = shallow.length;
>shallowLength : 8
>shallow.length : 8
>shallow : [unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown]
>length : 8

type Deep = BuildTuple<200>;
>Deep : [unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, unknown, ...any[]]

