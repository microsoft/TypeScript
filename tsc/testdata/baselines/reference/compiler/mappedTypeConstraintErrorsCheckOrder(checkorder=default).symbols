>Recur : Symbol(Recur, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 6, 24))
>N : Symbol(N, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 7, 11))
>S : Symbol(S, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 7, 28))

    N extends 0 ? S : Recur<Dec<N>, [S]>;
>N : Symbol(N, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 7, 11))
