// that is too deep, at the mapped type, whichever node first requests it.

type Dec<N extends number> =
>Dec : Symbol(Dec, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 0, 0))
>N : Symbol(N, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 3, 9))

    N extends 5 ? 4 : N extends 4 ? 3 : N extends 3 ? 2 :
>N : Symbol(N, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 3, 9))
>N : Symbol(N, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 3, 9))
>N : Symbol(N, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 3, 9))

    N extends 2 ? any :
>N : Symbol(N, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 3, 9))

    N extends 1 ? 0 : 0;
>N : Symbol(N, Decl(mappedTypeConstraintErrorsCheckOrder.ts, 3, 9))

