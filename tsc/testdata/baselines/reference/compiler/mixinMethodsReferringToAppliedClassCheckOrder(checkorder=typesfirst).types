=== mixinMethodsReferringToAppliedClassCheckOrder.ts ===
// The mixin classes have methods referring to the class built from them,
// so checking the classes and typing their members first reach the same
// cycle in different places (55640).

type ConstructorType<T> = abstract new (...args: any[]) => T;
>ConstructorType : ConstructorType<T>
>args : any[]

function makeMixin<TBase extends ConstructorType<any>, FinalConstructor>(
>makeMixin : <TBase extends ConstructorType<any>, FinalConstructor>(mixinFunction: (Base: TBase) => FinalConstructor) => (Base?: TBase) => FinalConstructor

    mixinFunction: (Base: TBase) => FinalConstructor
>mixinFunction : (Base: TBase) => FinalConstructor
>Base : TBase

): (Base?: TBase) => FinalConstructor {
>Base : TBase | undefined

    return (Base?: TBase) => {
>(Base?: TBase) => {        // do other things with Base, this example is simplified        return mixinFunction(Base ?? (Object as any));    } : (Base?: TBase) => FinalConstructor
>Base : TBase | undefined

        // do other things with Base, this example is simplified
        return mixinFunction(Base ?? (Object as any));
>mixinFunction(Base ?? (Object as any)) : FinalConstructor
>mixinFunction : (Base: TBase) => FinalConstructor
>Base ?? (Object as any) : any
>Base : TBase | undefined
>(Object as any) : any
>Object as any : any
>Object : ObjectConstructor

    };
}

