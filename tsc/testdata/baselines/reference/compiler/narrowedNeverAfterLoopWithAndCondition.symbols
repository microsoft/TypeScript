>value_def : Symbol(value_def, Decl(narrowedNeverAfterLoopWithAndCondition.ts, 13, 7))
>last_ref : Symbol(last_ref, Decl(narrowedNeverAfterLoopWithAndCondition.ts, 13, 20))

    if (value_def) {
>value_def : Symbol(value_def, Decl(narrowedNeverAfterLoopWithAndCondition.ts, 13, 7))

        while (x);
>x : Symbol(x, Decl(narrowedNeverAfterLoopWithAndCondition.ts, 12, 11))

        value_def.last_ref = false;
>value_def : Symbol(value_def, Decl(narrowedNeverAfterLoopWithAndCondition.ts, 13, 7))
    }
}

