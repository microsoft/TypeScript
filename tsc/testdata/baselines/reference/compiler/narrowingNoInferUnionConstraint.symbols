>kind : Symbol(kind, Decl(narrowingNoInferUnionConstraint.ts, 13, 46))
>b : Symbol(b, Decl(narrowingNoInferUnionConstraint.ts, 13, 57))
>kind : Symbol(kind, Decl(narrowingNoInferUnionConstraint.ts, 13, 74))

interface Box<T> {
>Box : Symbol(Box, Decl(narrowingNoInferUnionConstraint.ts, 13, 87))
>T : Symbol(T, Decl(narrowingNoInferUnionConstraint.ts, 15, 14))

    u: U2;
>u : Symbol(Box.u, Decl(narrowingNoInferUnionConstraint.ts, 15, 18))
>U2 : Symbol(U2, Decl(narrowingNoInferUnionConstraint.ts, 9, 1))

    t: T;
>t : Symbol(Box.t, Decl(narrowingNoInferUnionConstraint.ts, 16, 10))
>T : Symbol(T, Decl(narrowingNoInferUnionConstraint.ts, 15, 14))
}

declare const box: Box<string>;
>box : Symbol(box, Decl(narrowingNoInferUnionConstraint.ts, 20, 13))
>Box : Symbol(Box, Decl(narrowingNoInferUnionConstraint.ts, 13, 87))

box.u;
>box.u : Symbol(Box.u, Decl(narrowingNoInferUnionConstraint.ts, 15, 18))
>box : Symbol(box, Decl(narrowingNoInferUnionConstraint.ts, 20, 13))
>u : Symbol(Box.u, Decl(narrowingNoInferUnionConstraint.ts, 15, 18))

function f2(u: U2) {
>f2 : Symbol(f2, Decl(narrowingNoInferUnionConstraint.ts, 21, 6))
>u : Symbol(u, Decl(narrowingNoInferUnionConstraint.ts, 23, 12))
>U2 : Symbol(U2, Decl(narrowingNoInferUnionConstraint.ts, 9, 1))

    if (u.kind === "a") {
>u.kind : Symbol(kind, Decl(narrowingNoInferUnionConstraint.ts, 13, 19), Decl(narrowingNoInferUnionConstraint.ts, 13, 46), Decl(narrowingNoInferUnionConstraint.ts, 13, 74))
>u : Symbol(u, Decl(narrowingNoInferUnionConstraint.ts, 23, 12))
>kind : Symbol(kind, Decl(narrowingNoInferUnionConstraint.ts, 13, 19), Decl(narrowingNoInferUnionConstraint.ts, 13, 46), Decl(narrowingNoInferUnionConstraint.ts, 13, 74))

        u.a;
>u.a : Symbol(a, Decl(narrowingNoInferUnionConstraint.ts, 13, 30))
>u : Symbol(u, Decl(narrowingNoInferUnionConstraint.ts, 23, 12))
>a : Symbol(a, Decl(narrowingNoInferUnionConstraint.ts, 13, 30))
    }
}

