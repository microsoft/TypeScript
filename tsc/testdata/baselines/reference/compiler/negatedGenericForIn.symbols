function copyNodeProperties<NodeType extends NodeBase>(node: NodeType, clone: NodeType) {
>copyNodeProperties : Symbol(copyNodeProperties, Decl(negatedGenericForIn.ts, 8, 64))
>NodeType : Symbol(NodeType, Decl(negatedGenericForIn.ts, 10, 28))
