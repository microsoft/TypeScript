//// [tests/cases/compiler/negatedRequiredKeysInferConstraint.ts] ////

=== negatedRequiredKeysInferConstraint.ts ===
type MyExclude<T, U> = T & not U;
>MyExclude : MyExclude<T, U>

type Simplify<T> = { [Key in keyof T]: T[Key] };
>Simplify : Simplify<T>

type OptionalKeys<T extends object> = {
>OptionalKeys : OptionalKeys<T>

    [Key in keyof T]: undefined extends T[Key] ? Key : never;
}[keyof T];
type RequiredKeys<T extends object> = MyExclude<keyof T, OptionalKeys<T>>;
>RequiredKeys : RequiredKeys<T>

interface Schema<Output> {
    output: Output;
>output : Output
}

type Shape = { [key: string]: Schema<any> };
>Shape : Shape
>key : string

interface ObjectSchema<
    T extends Shape,
    Output = Simplify<
        { [Key in OptionalKeys<T>]?: T[Key] } &
        { [Key in RequiredKeys<T>]: T[Key] }
    >
> extends Schema<Output> {
    shape: T;
>shape : T
}

type InferShape<T> = T extends ObjectSchema<infer Result>
>InferShape : InferShape<T>

    ? Result extends Shape ? Result : never
    : never;
