        acceptsCat(value);
>acceptsCat(value) : void
>acceptsCat : (value: Cat) => void
>value : Cat

    } else {
        acceptsNotCat(value);
>acceptsNotCat(value) : void
>acceptsNotCat : (value: not Cat) => void
>value : object & not Cat
    }
}

