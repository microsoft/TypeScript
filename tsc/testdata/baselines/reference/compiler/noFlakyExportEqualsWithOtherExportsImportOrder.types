=== /main.ts ===
/// <reference path="./ambient.d.ts" />
import { x } from "mm";
>x : 1

declare const oxa: typeof import("xa");
>oxa : O

declare const oxb: typeof import("xb");
>oxb : O

declare function expand<X>(): { [K in keyof X]: X[K] };
>expand : <X>() => { [K in keyof X]: X[K]; }

export const keep = x;
>keep : 1
>x : 1

export const obsA = expand<typeof oxa>();
>obsA : { pb: 0; readonly mb: 1; v: 0; }
>expand<typeof oxa>() : { pb: 0; readonly mb: 1; v: 0; }
>expand : <X>() => { [K in keyof X]: X[K]; }
>oxa : O

export const obsB = expand<typeof oxb>();
>obsB : { v: 0; }
>expand<typeof oxb>() : { v: 0; }
>expand : <X>() => { [K in keyof X]: X[K]; }
>oxb : O

=== /ambient.d.ts ===
