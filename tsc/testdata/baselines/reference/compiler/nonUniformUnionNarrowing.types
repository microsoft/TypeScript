>x === E.A : boolean
>x : 1 | 2 | E
>E.A : E.A
>E : typeof E
>A : E.A

        x;  // 1 | E.A
>x : 1 | E.A
    }
    else {
        x;  // 2 | E.B
>x : 2 | E.B
    }
}

function f1s(x: E | 1 | 2) {
>f1s : (x: E | 1 | 2) => void
>x : 1 | 2 | E

    switch (x) {
>x : 1 | 2 | E

