>withCategory : <Categories extends Array<PropertyKey>>(...categories: Categories) => <Args extends Array<any>, Ret, C extends { new (...args: Args): Ret; }>(C: C) => C & { new (...args: Args): Ret & { [categoriesKey]: { [Cat in Categories[number]]: true; }; }; }

