export type AllKeys<E> = E extends { [categoriesKey]: infer Q }
>AllKeys : AllKeys<E>
>[categoriesKey] : Q
>categoriesKey : "@effect/error/categories"

  ? keyof Q
  : never;
export type ExtractAll<E, Cats extends PropertyKey> = Cats extends any
