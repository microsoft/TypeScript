>ok4 : any
>["i", "a", ["i"]] : (string | string[])[]
>"i" : "i"
>"a" : "a"
>["i"] : string[]
>"i" : "i"

/** @type {JSDocLabeled} */
export const bad4 = ["i", 1];
>bad4 : any
>["i", 1] : (string | number)[]
>"i" : "i"
>1 : 1

