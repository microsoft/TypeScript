/** @typedef {string | ["i", ...rest: JSDocLabeled[]]} JSDocLabeled */

/** @type {JSDocLabeled} */
export const ok4 = ["i", "a", ["i"]];
>ok4 : JSDocLabeled
>["i", "a", ["i"]] : ["i", string, ["i"]]
>"i" : "i"
>"a" : "a"
>["i"] : ["i"]
>"i" : "i"

/** @type {JSDocLabeled} */
export const bad4 = ["i", 1];
>bad4 : JSDocLabeled
>["i", 1] : ["i", number]
>"i" : "i"
>1 : 1

