//// [tests/cases/compiler/recursiveTypeInference.ts] ////

=== recursiveTypeInference.ts ===
// Adaptation of examples from https://github.com/microsoft/TypeScript/issues/64192.

export interface _$ZodTypeInternals {
  def: unknown;
>def : unknown

  optin?: "optional" | undefined;
>optin : "optional" | undefined

  optout?: "optional" | undefined;
>optout : "optional" | undefined
}

export interface $ZodTypeInternals<out O = unknown, out I = unknown> extends _$ZodTypeInternals {
  output: O;
>output : O

  input: I;
>input : I
}

export type output<T extends $ZodType> = T["_zod"]["output"];
>output : output<T>

export type input<T extends $ZodType> = T["_zod"]["input"];
>input : input<T>

export interface $ZodType<O = unknown, I = unknown, Internals extends $ZodTypeInternals<O, I> = $ZodTypeInternals<O, I>> {
  _zod: Internals;
>_zod : Internals
}

// ---- string ----
export interface $ZodStringInternals extends $ZodTypeInternals<string, string> {
  def: { type: "string" };
>def : { type: "string"; }
>type : "string"
}
export interface $ZodString extends $ZodType {
  _zod: $ZodStringInternals;
>_zod : $ZodStringInternals
}
declare function string(): $ZodString;
>string : () => $ZodString

// ---- array ----
export interface $ZodArrayInternals<T extends $ZodType = $ZodType> extends $ZodTypeInternals<output<T>[], input<T>[]> {
  def: { type: "array"; element: T };
>def : { type: "array"; element: T; }
>type : "array"
>element : T
}
export interface $ZodArray<T extends $ZodType = $ZodType> extends $ZodType {
  _zod: $ZodArrayInternals<T>;
>_zod : $ZodArrayInternals<T>
}
declare function array<T extends $ZodType>(element: T): $ZodArray<T>;
>array : <T extends $ZodType>(element: T) => $ZodArray<T>
>element : T

// ---- optional ----
export interface $ZodOptionalInternals<T extends $ZodType = $ZodType>
  extends $ZodTypeInternals<output<T> | undefined, input<T> | undefined> {
  def: { type: "optional"; innerType: T };
>def : { type: "optional"; innerType: T; }
>type : "optional"
>innerType : T

  optin: "optional";
>optin : "optional"

  optout: "optional";
>optout : "optional"
}
export interface $ZodOptional<T extends $ZodType = $ZodType> extends $ZodType {
  _zod: $ZodOptionalInternals<T>;
>_zod : $ZodOptionalInternals<T>
}
declare function optional<T extends $ZodType>(inner: T): $ZodOptional<T>;
>optional : <T extends $ZodType>(inner: T) => $ZodOptional<T>
>inner : T

// ---- nullable ----
export interface $ZodNullableInternals<T extends $ZodType = $ZodType>
  extends $ZodTypeInternals<output<T> | null, input<T> | null> {
  def: { type: "nullable"; innerType: T };
>def : { type: "nullable"; innerType: T; }
>type : "nullable"
>innerType : T
}
export interface $ZodNullable<T extends $ZodType = $ZodType> extends $ZodType {
  _zod: $ZodNullableInternals<T>;
>_zod : $ZodNullableInternals<T>
}
declare function nullable<T extends $ZodType>(inner: T): $ZodNullable<T>;
>nullable : <T extends $ZodType>(inner: T) => $ZodNullable<T>
>inner : T

// ---- object ----
type OptionalOutSchema = { _zod: { optout: "optional" } };
>OptionalOutSchema : OptionalOutSchema
>_zod : { optout: "optional"; }
>optout : "optional"

type OptionalInSchema = { _zod: { optin: "optional" } };
>OptionalInSchema : OptionalInSchema
>_zod : { optin: "optional"; }
>optin : "optional"

export type $ZodShape = Readonly<{ [k: string]: $ZodType }>;
>$ZodShape : Readonly<{ [k: string]: $ZodType<unknown, unknown, $ZodTypeInternals<unknown, unknown>>; }>
>k : string

export type Prettify<T> = { [K in keyof T]: T[K] } & {};
>Prettify : { [K in keyof T]: T[K]; }

export type $InferObjectOutput<T extends $ZodShape> = Prettify<
>$InferObjectOutput : { -readonly [k in keyof T as T[k] extends OptionalOutSchema ? never : k]: T[k]["_zod"]["output"]; } & { -readonly [k in keyof T as T[k] extends OptionalOutSchema ? k : never]?: T[k]["_zod"]["output"] | undefined; } extends infer T_1 ? { [K in keyof T_1]: T_1[K]; } : never
  {
    -readonly [k in keyof T as T[k] extends OptionalOutSchema ? never : k]: T[k]["_zod"]["output"];
  } & {
    -readonly [k in keyof T as T[k] extends OptionalOutSchema ? k : never]?: T[k]["_zod"]["output"];
  }
>;
export type $InferObjectInput<T extends $ZodShape> = Prettify<
>$InferObjectInput : { -readonly [k in keyof T as T[k] extends OptionalInSchema ? never : k]: T[k]["_zod"]["input"]; } & { -readonly [k in keyof T as T[k] extends OptionalInSchema ? k : never]?: T[k]["_zod"]["input"] | undefined; } extends infer T_1 ? { [K in keyof T_1]: T_1[K]; } : never
  {
    -readonly [k in keyof T as T[k] extends OptionalInSchema ? never : k]: T[k]["_zod"]["input"];
  } & {
    -readonly [k in keyof T as T[k] extends OptionalInSchema ? k : never]?: T[k]["_zod"]["input"];
  }
>;

export interface $ZodObjectInternals<Shape extends $ZodShape = $ZodShape> extends $ZodTypeInternals {
  def: { type: "object"; shape: Shape };
>def : { type: "object"; shape: Shape; }
>type : "object"
>shape : Shape

  output: $InferObjectOutput<Shape>;
>output : { -readonly [k in keyof Shape as Shape[k] extends OptionalOutSchema ? never : k]: Shape[k]["_zod"]["output"]; } & { -readonly [k in keyof Shape as Shape[k] extends OptionalOutSchema ? k : never]?: Shape[k]["_zod"]["output"] | undefined; } extends infer T ? { [K in keyof T]: T[K]; } : never

  input: $InferObjectInput<Shape>;
>input : { -readonly [k in keyof Shape as Shape[k] extends OptionalInSchema ? never : k]: Shape[k]["_zod"]["input"]; } & { -readonly [k in keyof Shape as Shape[k] extends OptionalInSchema ? k : never]?: Shape[k]["_zod"]["input"] | undefined; } extends infer T ? { [K in keyof T]: T[K]; } : never
}
export interface $ZodObject<Shape extends $ZodShape = $ZodShape> extends $ZodType {
  _zod: $ZodObjectInternals<Shape>;
>_zod : $ZodObjectInternals<Shape>
}
declare function object<T extends $ZodShape>(shape: T): $ZodObject<T>;
>object : <T extends $ZodShape>(shape: T) => $ZodObject<T>
>shape : T

export const z = { string, array, object, optional, nullable };
>z : { string: () => $ZodString; array: <T extends $ZodType>(element: T) => $ZodArray<T>; object: <T extends $ZodShape>(shape: T) => $ZodObject<T>; optional: <T extends $ZodType>(inner: T) => $ZodOptional<T>; nullable: <T extends $ZodType>(inner: T) => $ZodNullable<T>; }
>{ string, array, object, optional, nullable } : { string: () => $ZodString; array: <T extends $ZodType>(element: T) => $ZodArray<T>; object: <T extends $ZodShape>(shape: T) => $ZodObject<T>; optional: <T extends $ZodType>(inner: T) => $ZodOptional<T>; nullable: <T extends $ZodType>(inner: T) => $ZodNullable<T>; }
>string : () => $ZodString
>array : <T extends $ZodType>(element: T) => $ZodArray<T>
>object : <T extends $ZodShape>(shape: T) => $ZodObject<T>
