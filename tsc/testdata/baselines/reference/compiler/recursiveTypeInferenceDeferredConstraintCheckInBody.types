interface ZodDefault<T extends $ZodType> extends ZodType<$ZodDefaultInternals<T>> {}
type TupleOut<T extends readonly $ZodType[]> = T extends readonly [infer H extends $ZodType, ...infer R extends $ZodType[]] ? [output<H>, ...TupleOut<R>] : [];
