//// [tests/cases/compiler/recursiveTypeInferenceDeferredConstraintCheckInBody.ts] ////

=== recursiveTypeInferenceDeferredConstraintCheckInBody.ts ===
// A generic call inside an un-annotated accessor whose inferred type argument mentions the enclosing object literal.
// The constraint check of that argument would instantiate the literal's inferred output type while the accessor is
// still unresolved, so it is deferred until the accessors of the file have been checked. The declarations mirror
// how zod exposes a schema's output: only through a property of the internals object, never through a base type
// argument.

type output<T> = T extends { _zod: { output: any } } ? T["_zod"]["output"] : unknown;
>output : output<T>
>_zod : { output: any; }
>output : any

type input<T> = T extends { _zod: { input: any } } ? T["_zod"]["input"] : unknown;
>input : input<T>
>_zod : { input: any; }
>input : any

type NoUndefined<T> = T extends undefined ? never : T;
>NoUndefined : NoUndefined<T>

type Writeable<T> = { -readonly [P in keyof T]: T[P] };
>Writeable : Writeable<T>

type Prettify<T> = { [K in keyof T]: T[K] } & {};
>Prettify : { [K in keyof T]: T[K]; }

interface $ZodTypeInternals<out O = unknown, out I = unknown> { def: unknown; output: O; input: I; optin?: "optional" | undefined; optout?: "optional" | undefined }
>def : unknown
>output : O
>input : I
>optin : "optional" | undefined
>optout : "optional" | undefined

interface StandardProps<I, O> { readonly types?: { readonly input: I; readonly output: O } | undefined }
>types : { readonly input: I; readonly output: O; } | undefined
>input : I
>output : O

interface $ZodType<O = unknown, I = unknown, Internals extends $ZodTypeInternals<O, I> = $ZodTypeInternals<O, I>> {
  _zod: Internals;
>_zod : Internals

  "~standard": StandardProps<input<this>, output<this>>;
>"~standard" : StandardProps<input<this>, output<this>>
}
interface ZodType<out Internals extends $ZodTypeInternals = $ZodTypeInternals> extends $ZodType<any, any, Internals> {
  default(def: NoUndefined<output<this>>): ZodDefault<this>;
>default : { (def: NoUndefined<output<this>>): ZodDefault<this>; (def: () => NoUndefined<output<this>>): ZodDefault<this>; }
>def : NoUndefined<output<this>>

  default(def: () => NoUndefined<output<this>>): ZodDefault<this>;
>default : { (def: NoUndefined<output<this>>): ZodDefault<this>; (def: () => NoUndefined<output<this>>): ZodDefault<this>; }
>def : () => NoUndefined<output<this>>
}
type Shape = Readonly<{ [k: string]: $ZodType }>;
>Shape : Readonly<{ [k: string]: $ZodType<unknown, unknown, $ZodTypeInternals<unknown, unknown>>; }>
>k : string

type OptionalOut = { _zod: { optout: "optional" } };
>OptionalOut : OptionalOut
>_zod : { optout: "optional"; }
>optout : "optional"

type OptionalIn = { _zod: { optin: "optional" } };
>OptionalIn : OptionalIn
>_zod : { optin: "optional"; }
>optin : "optional"

type $InferObjectOutput<T extends Shape> = Prettify<
>$InferObjectOutput : { -readonly [k in keyof T as T[k] extends OptionalOut ? never : k]: T[k]["_zod"]["output"]; } & { -readonly [k in keyof T as T[k] extends OptionalOut ? k : never]?: T[k]["_zod"]["output"] | undefined; } extends infer T_1 ? { [K in keyof T_1]: T_1[K]; } : never

  { -readonly [k in keyof T as T[k] extends OptionalOut ? never : k]: T[k]["_zod"]["output"] } &
  { -readonly [k in keyof T as T[k] extends OptionalOut ? k : never]?: T[k]["_zod"]["output"] }
>;
type $InferObjectInput<T extends Shape> = Prettify<
>$InferObjectInput : { -readonly [k in keyof T as T[k] extends OptionalIn ? never : k]: T[k]["_zod"]["input"]; } & { -readonly [k in keyof T as T[k] extends OptionalIn ? k : never]?: T[k]["_zod"]["input"] | undefined; } extends infer T_1 ? { [K in keyof T_1]: T_1[K]; } : never

  { -readonly [k in keyof T as T[k] extends OptionalIn ? never : k]: T[k]["_zod"]["input"] } &
  { -readonly [k in keyof T as T[k] extends OptionalIn ? k : never]?: T[k]["_zod"]["input"] }
>;
interface $ZodStringInternals extends $ZodTypeInternals { def: { type: "string" }; output: string; input: string }
>def : { type: "string"; }
>type : "string"
>output : string
>input : string

interface ZodString extends ZodType<$ZodStringInternals> {}
declare function string(): ZodString;
>string : () => ZodString

interface $ZodObjectInternals<S extends Shape> extends $ZodTypeInternals { def: { type: "object"; shape: S }; output: $InferObjectOutput<S>; input: $InferObjectInput<S> }
