t.f(42); // error
>t.f(42) : void
>t.f : (x: "x") => void
>t : Schema<{ name: string; readonly rec: { inner: any; }; }> & { p: "x"; q: 1; f: (x: "x") => void; }
>f : (x: "x") => void
>42 : 42

const tq: 1 = t.q;
>tq : 1
>t.q : 1
>t : Schema<{ name: string; readonly rec: { inner: any; }; }> & { p: "x"; q: 1; f: (x: "x") => void; }
>q : 1

const a = object({ name: str, get r() { return b; } }) satisfies { p: number | "x" };
>a : Schema<{ name: string; readonly r: { name: string; readonly r: any; }; }> & { p: "x"; q: 1; f: (x: "x") => void; }
