>{ name: str, get rec() { return object({ inner: t }); } } : { name: Schema<string>; readonly rec: Schema<{ inner: { name: string; readonly rec: any; }; }> & { p: keyof Lookup; q: 1 | 2; f: (x: keyof Lookup) => void; }; }
>name : Schema<string>
>str : Schema<string>
>rec : Schema<{ inner: { name: string; readonly rec: any; }; }> & { p: keyof Lookup; q: 1 | 2; f: (x: keyof Lookup) => void; }
