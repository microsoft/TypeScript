//// [tests/cases/compiler/recursiveTypeInferenceReturnTypeConstraint.ts] ////

=== recursiveTypeInferenceReturnTypeConstraint.ts ===
// A pure return type inference stays filtered by its constraint in a recursive call resolution.

interface Schema<O> { readonly out: O }
>out : O

type Shape = Record<string, Schema<any>>;
>Shape : Shape

type Lookup = { x: 1; dflt: 2 };
>Lookup : Lookup
>x : 1
>dflt : 2

declare function object<S extends Shape, P extends keyof Lookup>(shape: S): Schema<{ [K in keyof S]: S[K]["out"] }> & { p: P; q: Lookup[P]; f: (x: P) => void };
>object : <S extends Shape, P extends keyof Lookup>(shape: S) => Schema<{ [K in keyof S]: S[K]["out"]; }> & { p: P; q: Lookup[P]; f: (x: P) => void; }
>shape : S
>p : P
>q : Lookup[P]
>f : (x: P) => void
>x : P

declare const str: Schema<string>;
>str : Schema<string>

const u = object({ name: str }) satisfies { p: number | "x" };
>u : Schema<{ name: string; }> & { p: "x"; q: 1; f: (x: "x") => void; }
>object({ name: str }) satisfies { p: number | "x" } : Schema<{ name: string; }> & { p: "x"; q: 1; f: (x: "x") => void; }
>object({ name: str }) : Schema<{ name: string; }> & { p: "x"; q: 1; f: (x: "x") => void; }
>object : <S extends Shape, P extends keyof Lookup>(shape: S) => Schema<{ [K in keyof S]: S[K]["out"]; }> & { p: P; q: Lookup[P]; f: (x: P) => void; }
>{ name: str } : { name: Schema<string>; }
>name : Schema<string>
>str : Schema<string>
>p : number | "x"

u.f(42); // error
>u.f(42) : void
>u.f : (x: "x") => void
>u : Schema<{ name: string; }> & { p: "x"; q: 1; f: (x: "x") => void; }
>f : (x: "x") => void
>42 : 42

const t = object({ name: str, get rec() { return object({ inner: t }); } }) satisfies { p: number | "x" };
>t : Schema<{ name: string; readonly rec: { inner: any; }; }> & { p: "x"; q: 1; f: (x: "x") => void; }
>object({ name: str, get rec() { return object({ inner: t }); } }) satisfies { p: number | "x" } : Schema<{ name: string; readonly rec: { inner: any; }; }> & { p: "x"; q: 1; f: (x: "x") => void; }
