>{ inner: t } : { inner: Schema<{ name: string; readonly rec: { inner: any; }; }> & { p: "x"; q: 1; f: (x: "x") => void; }; }
>inner : Schema<{ name: string; readonly rec: { inner: any; }; }> & { p: "x"; q: 1; f: (x: "x") => void; }
>t : Schema<{ name: string; readonly rec: { inner: any; }; }> & { p: "x"; q: 1; f: (x: "x") => void; }
