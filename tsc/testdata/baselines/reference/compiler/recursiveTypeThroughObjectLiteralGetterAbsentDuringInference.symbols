>d : Symbol(d, Decl(recursiveTypeThroughObjectLiteralGetterAbsentDuringInference.ts, 29, 13))
>anything : Symbol(D.__index, Decl(recursiveTypeThroughObjectLiteralGetterAbsentDuringInference.ts, 24, 19))
}

