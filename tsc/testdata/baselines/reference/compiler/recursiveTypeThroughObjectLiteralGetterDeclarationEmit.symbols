>O : Symbol(O, Decl(recursiveTypeThroughObjectLiteralGetterDeclarationEmit.ts, 6, 20))

    readonly out: O;
>out : Symbol(Internals.out, Decl(recursiveTypeThroughObjectLiteralGetterDeclarationEmit.ts, 6, 38))
>O : Symbol(O, Decl(recursiveTypeThroughObjectLiteralGetterDeclarationEmit.ts, 6, 20))
}
