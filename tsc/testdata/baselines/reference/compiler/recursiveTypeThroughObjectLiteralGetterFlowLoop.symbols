>out : Symbol(Internals.out, Decl(recursiveTypeThroughObjectLiteralGetterFlowLoop.ts, 11, 38))
>O : Symbol(O, Decl(recursiveTypeThroughObjectLiteralGetterFlowLoop.ts, 11, 20))
}

