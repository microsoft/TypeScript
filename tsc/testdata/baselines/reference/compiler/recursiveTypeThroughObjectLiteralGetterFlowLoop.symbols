>out : Symbol(Internals.out, Decl(recursiveTypeThroughObjectLiteralGetterFlowLoop.ts, 13, 38))
>O : Symbol(O, Decl(recursiveTypeThroughObjectLiteralGetterFlowLoop.ts, 13, 20))
}

