=== structuralMeasurement.ts ===
export {};

interface GenericMethod<T> {
    value: T;
>value : T

    next: <U>(value: U) => GenericMethod<T>;
>next : <U>(value: U) => GenericMethod<T>
>value : U
}
interface Projected<T extends { value: unknown }> {
>value : unknown

    value: T["value"];
>value : T["value"]

    next: Projected<T>;
>next : Projected<T>
}
interface Method<T> {
    value: T;
>value : T

    accept(value: Method<T>): void;
>accept : (value: Method<T>) => void
>value : Method<T>
}

declare let strings: GenericMethod<string>;
>strings : GenericMethod<string>

declare let unknowns: GenericMethod<unknown>;
>unknowns : GenericMethod<unknown>

declare let stringMethod: Method<string>;
>stringMethod : Method<string>

declare let unknownMethod: Method<unknown>;
>unknownMethod : Method<unknown>

declare let projected: Projected<{ value: string; extra: number }>;
>projected : Projected<{ value: string; extra: number; }>
>value : string
>extra : number

unknowns = strings;
>unknowns = strings : GenericMethod<string>
>unknowns : GenericMethod<unknown>
>strings : GenericMethod<string>

strings = unknowns; // Error
>strings = unknowns : GenericMethod<unknown>
>strings : GenericMethod<string>
>unknowns : GenericMethod<unknown>

unknownMethod = stringMethod;
>unknownMethod = stringMethod : Method<string>
>unknownMethod : Method<unknown>
>stringMethod : Method<string>

const widened: Projected<{ value: string }> = projected;
>widened : Projected<{ value: string; }>
>value : string
>projected : Projected<{ value: string; extra: number; }>

