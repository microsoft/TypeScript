>stringPhantom : Phantom<string>
>numberPhantom : Phantom<number>

numberPhantom = stringPhantom;
>numberPhantom = stringPhantom : Phantom<string>
>numberPhantom : Phantom<number>
>stringPhantom : Phantom<string>

