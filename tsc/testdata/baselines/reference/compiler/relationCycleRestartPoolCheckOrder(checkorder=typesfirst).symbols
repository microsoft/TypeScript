//// [tests/cases/compiler/relationCycleRestartPoolCheckOrder.ts] ////

=== relationCycleRestartPoolCheckOrder.ts ===
// Tests that a relation cycle compared again from its least member keeps its
// guard while nested comparisons take relaters from the pool.
//
// Under the strict subtype relation, N4 -> G4 holds when N2 -> T2 fails and
// N1 -> G1 holds when N0 -> T0 fails (strict arity rejects an optional
// parameter whose type relates to the required one). N3 -> T3 holds when
// N4 -> G4 and N1 -> G1 hold; N2 -> T2 and N0 -> T0 hold when N3 -> T3 holds.
// Entered at N3 -> T3, the cycle restarts from N2 -> T2 and computes N3 -> T3
// again, which reaches N0 -> T0. Comparing N0 -> T0 resolves typeof functions,
// whose subtype reduction restarts a cycle of its own on relaters from the pool.
declare let a1: { a: N3; b: string }, a2: { a: T3 };
>a1 : Symbol(a1, Decl(relationCycleRestartPoolCheckOrder.ts, 10, 11))
>a : Symbol(a, Decl(relationCycleRestartPoolCheckOrder.ts, 10, 17))
>N3 : Symbol(N3, Decl(relationCycleRestartPoolCheckOrder.ts, 11, 17))
>b : Symbol(b, Decl(relationCycleRestartPoolCheckOrder.ts, 10, 24))
>a2 : Symbol(a2, Decl(relationCycleRestartPoolCheckOrder.ts, 10, 37))
>a : Symbol(a, Decl(relationCycleRestartPoolCheckOrder.ts, 10, 43))
>T3 : Symbol(T3, Decl(relationCycleRestartPoolCheckOrder.ts, 13, 27))

let a = [a1, a2];
>a : Symbol(a, Decl(relationCycleRestartPoolCheckOrder.ts, 11, 3))
>a1 : Symbol(a1, Decl(relationCycleRestartPoolCheckOrder.ts, 10, 11))
>a2 : Symbol(a2, Decl(relationCycleRestartPoolCheckOrder.ts, 10, 37))

type N3 = { b: N4; c: N1 };
>N3 : Symbol(N3, Decl(relationCycleRestartPoolCheckOrder.ts, 11, 17))
>b : Symbol(b, Decl(relationCycleRestartPoolCheckOrder.ts, 13, 11))
>N4 : Symbol(N4, Decl(relationCycleRestartPoolCheckOrder.ts, 18, 41))
>c : Symbol(c, Decl(relationCycleRestartPoolCheckOrder.ts, 13, 18))
>N1 : Symbol(N1, Decl(relationCycleRestartPoolCheckOrder.ts, 20, 52))

type T3 = { b: G4; c: G1 };
>T3 : Symbol(T3, Decl(relationCycleRestartPoolCheckOrder.ts, 13, 27))
>b : Symbol(b, Decl(relationCycleRestartPoolCheckOrder.ts, 14, 11))
>G4 : Symbol(G4, Decl(relationCycleRestartPoolCheckOrder.ts, 19, 29))
>c : Symbol(c, Decl(relationCycleRestartPoolCheckOrder.ts, 14, 18))
