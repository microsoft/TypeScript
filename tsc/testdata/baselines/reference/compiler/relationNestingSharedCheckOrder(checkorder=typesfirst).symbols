>T : Symbol(T, Decl(relationNestingSharedCheckOrder.ts, 6, 7))
>T : Symbol(T, Decl(relationNestingSharedCheckOrder.ts, 6, 7))

type R<T> = { next: R<[T]>; leaf: T };
>R : Symbol(R, Decl(relationNestingSharedCheckOrder.ts, 6, 71))
>T : Symbol(T, Decl(relationNestingSharedCheckOrder.ts, 7, 7))
