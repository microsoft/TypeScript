>leaf : Symbol(leaf, Decl(relationTruncatedCacheCheckOrder.ts, 6, 27))
>T : Symbol(T, Decl(relationTruncatedCacheCheckOrder.ts, 6, 7))
>T : Symbol(T, Decl(relationTruncatedCacheCheckOrder.ts, 6, 7))

