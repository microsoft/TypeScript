=== issue37760.ts ===
// https://github.com/microsoft/TypeScript/issues/37760
export {};
function alignof<T>(): number {
>alignof : <T>() => number

    return 1;
>1 : 1
}

// A right shift already parsed correctly.
function foo<T>(): number {
>foo : <T>() => number

    return 1 >> alignof<T[]>();
>1 >> alignof<T[]>() : number
>1 : 1
>alignof<T[]>() : number
>alignof : <T_1>() => number
}

// A left shift must not become two type-argument openers.
function bar<T>(): number {
>bar : <T>() => number

    return 1 << alignof<T[]>();
>1 << alignof<T[]>() : number
>1 : 1
>alignof<T[]>() : number
>alignof : <T_1>() => number
}

function baz<T>(): number {
>baz : <T>() => number

    // @ts-ignore
    return 1 << alignof<T[]>();
>1 << alignof<T[]>() : number
>1 : 1
>alignof<T[]>() : number
>alignof : <T_1>() => number
}

