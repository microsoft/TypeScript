function f1<A extends unknown[]>(x: [...A, number], y: [...A, number, number, number, number]) {
>f1 : <A extends unknown[]>(x: [...A, number], y: [...A, number, number, number, number]) => void
>x : [...A, number]
>y : [...A, number, number, number, number]

    x = y  // Error
>x = y : [...A, number, number, number, number]
>x : [...A, number]
>y : [...A, number, number, number, number]
}

