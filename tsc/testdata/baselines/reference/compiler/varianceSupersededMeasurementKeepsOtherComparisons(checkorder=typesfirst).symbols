//// [tests/cases/compiler/varianceSupersededMeasurementKeepsOtherComparisons.ts] ////

=== varianceSupersededMeasurementKeepsOtherComparisons.ts ===
// Reduced from zod v4 with LangGraph's `register` augmentation
// (langchain-ai/openwiki). Measuring the variance of B reaches A, which is
// smaller, so the measurement is superseded and measured again from A. While
// it finishes, comparing the parameters of `m` re-enters B, and its return
// type resolves `Check<B<number>>`, whose comparison is not part of the
// measurement. It must still compare as it would from scratch, as the
// resolved conditional type is kept.

declare let b1: B<string>;
>b1 : Symbol(b1, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 8, 11))
>B : Symbol(B, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 48))

declare let b2: B<"s">;
>b2 : Symbol(b2, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 9, 11))
>B : Symbol(B, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 48))

b1 = b2;
>b1 : Symbol(b1, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 8, 11))
>b2 : Symbol(b2, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 9, 11))

interface A<T> { m(x: B<T>): Check<B<number>>; }
>A : Symbol(A, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 10, 8))
>T : Symbol(T, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 12))
>m : Symbol(A.m, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 16))
>x : Symbol(x, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 19))
>B : Symbol(B, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 48))
>T : Symbol(T, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 12))
>Check : Symbol(Check, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 13, 27))
>B : Symbol(B, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 48))

interface B<T> { a: A<T>; }
>B : Symbol(B, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 48))
>T : Symbol(T, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 13, 12))
>a : Symbol(B.a, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 13, 16))
>A : Symbol(A, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 10, 8))
>T : Symbol(T, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 13, 12))

type Check<U> = U extends { a: unknown } ? "yes" : "no";
>Check : Symbol(Check, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 13, 27))
>U : Symbol(U, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 14, 11))
>U : Symbol(U, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 14, 11))
>a : Symbol(a, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 14, 27))

const v: Check<B<number>> = "yes";
>v : Symbol(v, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 16, 5))
>Check : Symbol(Check, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 13, 27))
>B : Symbol(B, Decl(varianceSupersededMeasurementKeepsOtherComparisons.ts, 12, 48))

