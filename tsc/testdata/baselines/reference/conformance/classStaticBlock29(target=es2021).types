    bar() {
>bar : () => number

        return 1;
>1 : 1
    }

    static {
        // Referencing the class by name makes the downleveled block use a class alias.
        Foo.count = 0;
>Foo.count = 0 : 0
>Foo.count : number
>Foo : typeof Foo
>count : number
>0 : 0

        this.count++;
>this.count++ : number
>this.count : number
>this : typeof Foo
>count : number

