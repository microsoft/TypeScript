// Evolving array created in an outer loop and pushed in an inner loop. The fix must not
// iterate for auto-typed variables: doing so finalizes the evolving array and degrades it to any[].

declare const outer: number[][];
>outer : Symbol(outer, Decl(controlFlowLoopSelfReferentialAssignment.ts, 60, 13))

function evolving() {
>evolving : Symbol(evolving, Decl(controlFlowLoopSelfReferentialAssignment.ts, 60, 32))

    let result;
>result : Symbol(result, Decl(controlFlowLoopSelfReferentialAssignment.ts, 62, 7))

    for (const list of outer) {
>list : Symbol(list, Decl(controlFlowLoopSelfReferentialAssignment.ts, 63, 14))
>outer : Symbol(outer, Decl(controlFlowLoopSelfReferentialAssignment.ts, 60, 13))

        result ||= [];
>result : Symbol(result, Decl(controlFlowLoopSelfReferentialAssignment.ts, 62, 7))

        for (const n of list) result.push(n);
>n : Symbol(n, Decl(controlFlowLoopSelfReferentialAssignment.ts, 65, 18))
>list : Symbol(list, Decl(controlFlowLoopSelfReferentialAssignment.ts, 63, 14))
>result.push : Symbol(Array.push, Decl(lib.es5.d.ts, --, --))
>result : Symbol(result, Decl(controlFlowLoopSelfReferentialAssignment.ts, 62, 7))
>push : Symbol(Array.push, Decl(lib.es5.d.ts, --, --))
>n : Symbol(n, Decl(controlFlowLoopSelfReferentialAssignment.ts, 65, 18))
    }
    return result; // should be number[] | undefined
>result : Symbol(result, Decl(controlFlowLoopSelfReferentialAssignment.ts, 62, 7))
}

