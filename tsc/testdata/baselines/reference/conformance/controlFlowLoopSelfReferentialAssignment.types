>cur = cur.parent : WithProp2 | WithProp3 | null
>cur : WithProp1 | WithProp2 | WithProp3 | null
>cur.parent : WithProp2 | WithProp3 | null
>cur : WithProp1 | WithProp2 | WithProp3
>parent : WithProp2 | WithProp3 | null
    }
}

// Evolving array created in an outer loop and pushed in an inner loop. The fix must not
// iterate for auto-typed variables: doing so finalizes the evolving array and degrades it to any[].

declare const outer: number[][];
>outer : number[][]

function evolving() {
>evolving : () => number[] | undefined

    let result;
>result : any

    for (const list of outer) {
>list : number[]
>outer : number[][]

        result ||= [];
>result ||= [] : any
>result : any
>[] : never[]

        for (const n of list) result.push(n);
>n : number
>list : number[]
>result.push(n) : number
>result.push : (...items: any[]) => number
>result : any[]
>push : (...items: any[]) => number
>n : number
    }
    return result; // should be number[] | undefined
>result : number[] | undefined
}

