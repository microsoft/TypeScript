//// [tests/cases/conformance/jsdoc/importTag5.ts] ////

=== /types.ts ===
export interface Foo {
    a: number;
>a : number
}
export interface Unused {
    unused: true;
>unused : true
>true : true
}

=== /foo.js ===
/**
 * @import { Foo } from "./types"
 */

/**
 * @param { Foo } foo
 */
function f(foo) {}
>f : (foo: Foo) => void
>foo : Foo

=== /imports.js ===
/**
 * @import { Foo, Unused } from "./types"
 */
/**
 * @param {Foo} foo
 */
export function filtered(foo) {
>filtered : (foo: Foo) => Foo
>foo : Foo

    return foo;
>foo : Foo
}
/**
 * @import * as types from "./types"
 */
/**
 * @param {types.Foo} foo
 */
export function namespace(foo) {
>namespace : (foo: types.Foo) => Foo
>foo : Foo

    return foo;
>foo : Foo
}

