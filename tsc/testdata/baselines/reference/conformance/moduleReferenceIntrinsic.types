>specifier : string
>ref : ModuleReference<T>

    specifier.length;
>specifier.length : number
>specifier : string
>length : number

    return importDeferred(ref);
>importDeferred(ref) : Promise<T>
>importDeferred : <T_1>(ref: ModuleReference<T_1>) => Promise<T_1>
