>Negate : Symbol(Negate, Decl(negatedTypesGenericInference.ts, 22, 30))
>T : Symbol(T, Decl(negatedTypesGenericInference.ts, 26, 26))
>T : Symbol(T, Decl(negatedTypesGenericInference.ts, 26, 26))

declare const nv: not number;
