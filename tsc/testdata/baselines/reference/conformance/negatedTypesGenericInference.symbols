>T : Symbol(T, Decl(negatedTypesGenericInference.ts, 25, 12))
>T : Symbol(T, Decl(negatedTypesGenericInference.ts, 25, 12))

declare function viaAlias<T>(x: Negate<T>): T;
>viaAlias : Symbol(viaAlias, Decl(negatedTypesGenericInference.ts, 25, 23))
