>Uppercase : Symbol(Uppercase, Decl(lib.es5.d.ts, --, --))

type U3 = Uppercase<not ("a" | "b")>;
>U3 : Symbol(U3, Decl(negatedTypesInStringMapping.ts, 4, 32))
>Uppercase : Symbol(Uppercase, Decl(lib.es5.d.ts, --, --))

type U4 = Uppercase<string & not "bar">;
>U4 : Symbol(U4, Decl(negatedTypesInStringMapping.ts, 5, 37))
>Uppercase : Symbol(Uppercase, Decl(lib.es5.d.ts, --, --))

// Negation applied to a string mapping type: `not Uppercase<T>`.
type N1 = not Uppercase<"bar">;
